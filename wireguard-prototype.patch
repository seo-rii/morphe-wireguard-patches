+                        // is a simulated process, so release its socket explicitly.
+                        var field = WireGuardProxy.class.getDeclaredField("failureListener");
+                        field.setAccessible(true);
+                        ((ServerSocket) field.get(null)).close();
+                    }
+                }
+            }
+            """;
