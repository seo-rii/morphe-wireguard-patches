+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"encoding/base64"
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+func fixtureConfig() string {
+	// Deliberately public synthetic test keys, not real account credentials.
+	private, public := [32]byte{1, 2, 3, 4}, [32]byte{5, 6, 7, 8}
+	return "[Interface]\nPrivateKey = " + base64.StdEncoding.EncodeToString(private[:]) + "\nAddress = 10.77.0.2/32\nDNS = 10.77.0.1\n\n[Peer]\nPublicKey = " + base64.StdEncoding.EncodeToString(public[:]) + "\nEndpoint = 127.0.0.1:51820\nAllowedIPs = 10.77.0.0/24\nPersistentKeepalive = 25\n"
+}
+
+func TestValidateSupportedConfig(t *testing.T) {
+	for _, text := range []string{
+		fixtureConfig(),
+		"# 한글 주석 및 😀 emoji are UTF-8\n" + fixtureConfig(),
+		"\ufeff" + strings.ReplaceAll(fixtureConfig(), "\n", "\r\n"),
+		strings.Replace(fixtureConfig(), "Address = 10.77.0.2/32", "Address = 10.77.0.2/32, fd00:77::2/128\nMTU = 1280", 1),
+		strings.Replace(fixtureConfig(), "Endpoint = 127.0.0.1:51820", "Endpoint = [::1]:51820 # test peer", 1),
+	} {
+		if err := Validate(text); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestValidateRejectsUnsupportedOrUnsafeConfig(t *testing.T) {
+	cases := map[string]string{
+		"shell hook":         strings.Replace(fixtureConfig(), "[Peer]", "PostUp = touch /tmp/never-executed\n[Peer]", 1),
+		"routing table":      strings.Replace(fixtureConfig(), "[Peer]", "Table = auto\n[Peer]", 1),
+		"save config":        strings.Replace(fixtureConfig(), "[Peer]", "SaveConfig = true\n[Peer]", 1),
+		"hostname endpoint":  strings.Replace(fixtureConfig(), "127.0.0.1:51820", "vpn.example:51820", 1),
+		"endpoint no port":   strings.Replace(fixtureConfig(), "127.0.0.1:51820", "127.0.0.1", 1),
+		"zero endpoint port": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "127.0.0.1:0", 1),
+		"endpoint multicast": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "224.0.0.1:51820", 1),
+		"endpoint broadcast": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "255.255.255.255:51820", 1),
+		"mapped unspecified": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "[::ffff:0.0.0.0]:51820", 1),
+		"second peer":        fixtureConfig() + "[Peer]\n",
+		"duplicate key":      strings.Replace(fixtureConfig(), "[Peer]", "MTU = 1420\nMTU = 1420\n[Peer]", 1),
+		"out of route DNS":   strings.Replace(fixtureConfig(), "DNS = 10.77.0.1", "DNS = 1.1.1.1", 1),
+		"DNS search domain":  strings.Replace(fixtureConfig(), "DNS = 10.77.0.1", "DNS = private.example", 1),
+		"no DNS":             strings.Replace(fixtureConfig(), "DNS = 10.77.0.1\n", "", 1),
+		"unknown directive":  fixtureConfig() + "Other = 1\n",
+		"invalid range":      strings.Replace(fixtureConfig(), "10.77.0.0/24", "10.77.0.0/33", 1),
+		"missing interface":  strings.Replace(fixtureConfig(), "[Interface]\n", "", 1),
+		"short key":          strings.Replace(fixtureConfig(), "PrivateKey = ", "PrivateKey = BAD", 1),
+		"negative keepalive": strings.Replace(fixtureConfig(), "= 25", "= -1", 1),
+		"oversized":          strings.Repeat("#", MaxConfigBytes+1),
+		"long line":          strings.Repeat("#", maxConfigLine+1),
+		"embedded NUL":       fixtureConfig() + "\x00",
+		"invalid UTF8":       fixtureConfig() + "\xff",
+	}
+	for name, text := range cases {
+		t.Run(name, func(t *testing.T) {
+			err := Validate(text)
+			if err == nil {
+				t.Fatal("expected rejection")
+			}
+			if strings.Contains(err.Error(), "touch") || strings.Contains(err.Error(), "AQIDBA") || strings.Contains(err.Error(), "vpn.example") {
+				t.Fatal("validation error leaked a config value")
+			}
+		})
+	}
+}
+
+func TestAllowedIPsAreNotExpanded(t *testing.T) {
+	c, err := parseConfig(fixtureConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.clearKeys()
+	if !c.allows(netip.MustParseAddr("10.77.0.1")) || c.allows(netip.MustParseAddr("8.8.8.8")) {
+		t.Fatal("AllowedIPs policy was not preserved")
+	}
+	if strings.Contains(c.uapi(), "allowed_ip=0.0.0.0/0") {
+		t.Fatal("configuration silently gained a default route")
+	}
+}
+
+func FuzzValidate(f *testing.F) {
+	f.Add(fixtureConfig())
+	f.Add("[Interface]\nPostUp=should-not-run\n")
+	f.Add("")
+	f.Fuzz(func(t *testing.T, text string) {
+		_ = Validate(text)
+	})
+}
diff --git a/native/wireguard/engine.go b/native/wireguard/engine.go
new file mode 100644
index 0000000000000000000000000000000000000000..fc760dc8fe8cce9be9a91d67c3bfe2297ef8e7f1
--- /dev/null
+++ b/native/wireguard/engine.go
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/net/netutil"
+	"golang.zx2c4.com/wireguard/conn"
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+const (
+	maxConnections = 128
+	dialTimeout    = 20 * time.Second
+	idleTimeout    = 2 * time.Minute
+)
+
+var (
+	errClosed   = errors.New("WireGuard proxy is stopped")
+	errNoRoute  = errors.New("destination is not covered by AllowedIPs")
+	errBadInput = errors.New("invalid proxy destination")
+)
+
+// Engine owns one WireGuard peer and an authenticated, IPv4-loopback-only HTTP
+// proxy. A successful Start means ready to attempt traffic, not an established
+// handshake or verified access to the Internet.
+type Engine struct {
+	config     *config
+	stack      *netstack.Net
+	device     *device.Device
+	server     *http.Server
+	transport  *http.Transport
+	listener   net.Listener
+	port       int
+	authDigest [32]byte
+	ctx        context.Context
+	cancel     context.CancelFunc
+	closeOnce  sync.Once
+	done       chan struct{}
+
+	mu          sync.Mutex
+	closed      bool
+	connections map[net.Conn]struct{}
+}
+
+// Start configures an entirely userspace tunnel and returns a local proxy.
+// Numeric endpoints make startup independent of DNS and peer reachability.
+// listenPort may be zero to request an ephemeral port. Credentials are required
+// because Android apps can access each other's loopback TCP listeners.
+func Start(text, username, password string, listenPort int) (*Engine, error) {
+	return startWithBind(text, username, password, listenPort, conn.NewDefaultBind())
+}
+
+// startWithBind is a private test seam for upstream's in-memory ChannelBind.
+// Production always uses Start's official default UDP transport; there is no
+// alternate transport or permission fallback selected at runtime.
+func startWithBind(text, username, password string, listenPort int, bind conn.Bind) (*Engine, error) {
+	c, err := parseConfig(text)
+	if err != nil {
+		return nil, err
+	}
+	defer c.clearKeys()
+	if !validCredentials(username, password) || listenPort < 0 || listenPort > 65535 {
+		return nil, errors.New("invalid local proxy credentials or port")
+	}
+	tun, stack, err := netstack.CreateNetTUN(c.addresses, c.dns, c.mtu)
+	if err != nil {
+		return nil, errors.New("could not initialize the userspace network stack")
+	}
+	// The default logger is deliberately silent, including UAPI failures.
+	dev := device.NewDevice(tun, bind, device.NewLogger(device.LogLevelSilent, ""))
+	if err := dev.IpcSet(c.uapi()); err != nil {
+		dev.Close()
+		return nil, errors.New("could not configure the WireGuard engine")
+	}
+	if err := dev.Up(); err != nil {
+		dev.Close()
+		return nil, errors.New("could not open the WireGuard transport")
+	}
+	listener, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(listenPort)))
+	if err != nil {
+		dev.Close()
+		return nil, errors.New("could not bind the local proxy port")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	e := &Engine{
+		config:      c,
+		stack:       stack,
+		device:      dev,
+		listener:    netutil.LimitListener(listener, maxConnections),
+		port:        listener.Addr().(*net.TCPAddr).Port,
+		authDigest:  sha256.Sum256([]byte("Basic " + base64.StdEncoding.EncodeToString([]byte(username+":"+password)))),
+		ctx:         ctx,
+		cancel:      cancel,
+		done:        make(chan struct{}),
+		connections: make(map[net.Conn]struct{}),
+	}
+	e.transport = &http.Transport{
+		Proxy:                 nil, // Never use environment/system proxies.
+		DialContext:           e.dialContext,
+		MaxIdleConns:          32,
+		MaxIdleConnsPerHost:   8,
+		MaxConnsPerHost:       32,
+		IdleConnTimeout:       30 * time.Second,
+		ResponseHeaderTimeout: 30 * time.Second,
+		TLSHandshakeTimeout:   10 * time.Second,
+		ExpectContinueTimeout: time.Second,
+	}
+	e.server = &http.Server{
+		Handler:           http.HandlerFunc(e.serveHTTP),
+		ReadHeaderTimeout: 10 * time.Second,
+		IdleTimeout:       30 * time.Second,
+		MaxHeaderBytes:    32 * 1024,
+		ErrorLog:          log.New(io.Discard, "", 0),
+		BaseContext:       func(net.Listener) context.Context { return e.ctx },
+		ConnState: func(c net.Conn, state http.ConnState) {
+			switch state {
+			case http.StateNew:
+				e.track(c)
+			case http.StateClosed:
+				e.untrack(c)
+			}
+		},
+	}
+	go func() {
+		defer close(e.done)
+		// There is no secret-bearing log output or fallback on Serve failure.
+		_ = e.server.Serve(e.listener)
+	}()
+	return e, nil
+}
+
+func validCredentials(username, password string) bool {
+	if len(username) < 1 || len(username) > 128 || len(password) < 16 || len(password) > 256 || strings.Contains(username, ":") {
+		return false
+	}
+	for _, v := range []string{username, password} {
+		for _, r := range v {
+			if r < 0x21 || r > 0x7e {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Port returns the bound 127.0.0.1 TCP port.
+func (e *Engine) Port() int { return e.port }
+
+// Close is idempotent. It cancels pending requests and closes all streams,
+// including CONNECT streams that net/http no longer owns after hijacking.
+func (e *Engine) Close() {
+	e.closeOnce.Do(func() {
+		e.cancel()
+		e.mu.Lock()
+		e.closed = true
+		connections := make([]net.Conn, 0, len(e.connections))
+		for c := range e.connections {
+			connections = append(connections, c)
+		}
+		e.mu.Unlock()
+		_ = e.server.Close()
+		for _, c := range connections {
+			_ = c.Close()
+		}
+		e.transport.CloseIdleConnections()
+		e.device.Close() // Owns and closes its userspace TUN exactly once.
+		<-e.done
+	})
+}
+
+func (e *Engine) track(c net.Conn) bool {
+	e.mu.Lock()
+	if e.closed {
+		e.mu.Unlock()
+		_ = c.Close()
+		return false
+	}
+	e.connections[c] = struct{}{}
+	e.mu.Unlock()
+	return true
+}
+
+func (e *Engine) untrack(c net.Conn) {
+	e.mu.Lock()
+	delete(e.connections, c)
+	e.mu.Unlock()
+}
+
+func (e *Engine) dialContext(parent context.Context, network, address string) (net.Conn, error) {
+	if network != "tcp" && network != "tcp4" && network != "tcp6" {
+		return nil, errBadInput
+	}
+	host, portText, err := net.SplitHostPort(address)
+	if err != nil || host == "" || strings.ContainsAny(host, "\x00\r\n\t /\\@") {
+		return nil, errBadInput
+	}
+	port, err := strconv.ParseUint(portText, 10, 16)
+	if err != nil || port == 0 {
+		return nil, errBadInput
+	}
+	ctx, cancel := context.WithTimeout(parent, dialTimeout)
+	defer cancel()
+	stopCancel := context.AfterFunc(e.ctx, cancel)
+	defer stopCancel()
+	if e.ctx.Err() != nil {
+		return nil, errClosed
+	}
+	// This resolver uses ONLY DNS servers in the userspace stack. Never replace
+	// it with net.Lookup*, net.DefaultResolver, or net.Dial(er).
+	addresses, err := e.stack.LookupContextHost(ctx, host)
+	if err != nil {
+		return nil, errors.New("tunneled DNS resolution failed")
+	}
+	var candidates []netip.Addr
+	for _, address := range addresses {
+		addr, err := netip.ParseAddr(address)
+		if err != nil {
+			continue
+		}
+		addr = addr.Unmap()
+		if !e.config.hasFamily(addr) || !e.config.allows(addr) || (network == "tcp4" && !addr.Is4()) || (network == "tcp6" && !addr.Is6()) {
+			continue
+		}
+		candidates = append(candidates, addr)
+	}
+	if len(candidates) == 0 {
+		return nil, errNoRoute
+	}
+	for i, addr := range candidates {
+		if ctx.Err() != nil {
+			break
+		}
+		deadline, _ := ctx.Deadline()
+		budget := time.Until(deadline) / time.Duration(len(candidates)-i)
+		attempt, cancelAttempt := context.WithTimeout(ctx, budget)
+		c, err := e.stack.DialContextTCPAddrPort(attempt, netip.AddrPortFrom(addr, uint16(port)))
+		cancelAttempt()
+		if err != nil {
+			continue
+		}
+		tracked := &trackedConn{idleConn: &idleConn{Conn: c, timeout: idleTimeout}, engine: e}
+		if !e.track(tracked) {
+			return nil, errClosed
+		}
+		return tracked, nil
+	}
+	return nil, errors.New("WireGuard destination connection failed")
+}
+
+// trackedConn applies a sliding idle deadline to bound abandoned streams while
+// allowing active video transfers to last indefinitely.
+type trackedConn struct {
+	*idleConn
+	engine *Engine
+	once   sync.Once
+}
+
+func (c *trackedConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		err = c.Conn.Close()
+		c.engine.untrack(c)
+	})
+	return err
+}
+
+func (c *trackedConn) CloseWrite() error {
+	if half, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return half.CloseWrite()
+	}
+	return c.Close()
+}
+
+func (e *Engine) String() string {
+	return fmt.Sprintf("WireGuard local proxy on 127.0.0.1:%d", e.port)
+}
diff --git a/native/wireguard/engine_test.go b/native/wireguard/engine_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b2be7d14124d9e1283580a4ea22a56707a1aa0a9
--- /dev/null
+++ b/native/wireguard/engine_test.go
@@ -0,0 +1,476 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"log"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golang.org/x/net/dns/dnsmessage"
+	"golang.zx2c4.com/wireguard/conn"
+	"golang.zx2c4.com/wireguard/conn/bindtest"
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+const testUser = "test-app"
+const testPassword = "test-only-random-looking-password-32"
+
+type testPeer struct {
+	config       string
+	stack        *netstack.Net
+	dev          *device.Device
+	dnsQueries   atomic.Int64
+	requests     atomic.Int64
+	authLeaked   atomic.Bool
+	httpPort     string
+	httpsPort    string
+	certificates *x509.CertPool
+	clientBind   conn.Bind // nil selects production Start and real UDP.
+}
+
+// newTestPeer creates an actual WireGuard server in a second userspace network
+// stack. Only outer UDP packets use host networking, bound to an ephemeral port.
+// HTTP and DNS servers live at private, virtual addresses. No root, /dev/net/tun,
+// external VPN accounts, outbound Internet traffic, or persisted keys are used.
+func newTestPeer(t *testing.T) *testPeer {
+	return newTestPeerWithBind(t, conn.NewDefaultBind(), nil, false)
+}
+
+// newMemoryTestPeer tests the same encryption/netstack/proxy with WireGuard's
+// upstream ChannelBind. It performs no UDP or host route-monitoring operations
+// and is explicitly separate from the real-UDP integration tests above.
+func newMemoryTestPeer(t *testing.T) *testPeer {
+	binds := bindtest.NewChannelBinds()
+	return newTestPeerWithBind(t, binds[0], binds[1], false)
+}
+
+func (p *testPeer) start(t *testing.T) *Engine {
+	t.Helper()
+	var engine *Engine
+	var err error
+	if p.clientBind == nil {
+		engine, err = Start(p.config, testUser, testPassword, 0)
+	} else {
+		engine, err = startWithBind(p.config, testUser, testPassword, 0, p.clientBind)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(engine.Close)
+	return engine
+}
+
+func newTestPeerWithBind(t *testing.T, serverBind, clientBind conn.Bind, ipv6 bool) *testPeer {
+	t.Helper()
+	serverKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	clientKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serverIP := netip.MustParseAddr("10.77.0.1")
+	clientAddress, allowedIPs := "10.77.0.2/32", "10.77.0.0/24"
+	if ipv6 {
+		serverIP = netip.MustParseAddr("fd77::1")
+		clientAddress, allowedIPs = "fd77::2/128", "fd77::/64"
+	}
+	tun, stack, err := netstack.CreateNetTUN([]netip.Addr{serverIP}, nil, 1420)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dev := device.NewDevice(tun, serverBind, device.NewLogger(device.LogLevelSilent, ""))
+	t.Cleanup(dev.Close)
+	uapi := fmt.Sprintf("private_key=%s\nlisten_port=0\npublic_key=%s\nallowed_ip=%s\n", hex.EncodeToString(serverKey.Bytes()), hex.EncodeToString(clientKey.PublicKey().Bytes()), clientAddress)
+	if err := dev.IpcSet(uapi); err != nil {
+		t.Fatal("test peer configuration failed")
+	}
+	if err := dev.Up(); err != nil {
+		t.Fatal(err)
+	}
+	state, err := dev.IpcGet()
+	if err != nil {
+		t.Fatal("test peer state unavailable")
+	}
+	var port string
+	for _, line := range strings.Split(state, "\n") {
+		if strings.HasPrefix(line, "listen_port=") {
+			port = strings.TrimPrefix(line, "listen_port=")
+		}
+	}
+	if port == "" || port == "0" {
+		t.Fatal("test peer has no UDP port")
+	}
+	p := &testPeer{stack: stack, dev: dev, clientBind: clientBind}
+	p.config = fmt.Sprintf("[Interface]\nPrivateKey = %s\nAddress = %s\nDNS = %s\n\n[Peer]\nPublicKey = %s\nAllowedIPs = %s\nEndpoint = 127.0.0.1:%s\n", base64.StdEncoding.EncodeToString(clientKey.Bytes()), clientAddress, serverIP.String(), base64.StdEncoding.EncodeToString(serverKey.PublicKey().Bytes()), allowedIPs, port)
+	dns, err := stack.ListenUDPAddrPort(netip.AddrPortFrom(serverIP, 53))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = dns.Close() })
+	go func() {
+		packet := make([]byte, 4096)
+		for {
+			n, client, err := dns.ReadFrom(packet)
+			if err != nil {
+				return
+			}
+			var request dnsmessage.Message
+			if request.Unpack(packet[:n]) != nil {
+				continue
+			}
+			p.dnsQueries.Add(1)
+			response := dnsmessage.Message{Header: dnsmessage.Header{ID: request.ID, Response: true, Authoritative: true, RecursionDesired: request.RecursionDesired, RecursionAvailable: true}, Questions: request.Questions}
+			for _, question := range request.Questions {
+				if question.Type == dnsmessage.TypeA && serverIP.Is4() {
+					ip := serverIP.As4()
+					if question.Name.String() == "blocked.test." {
+						ip = [4]byte{203, 0, 113, 50}
+					}
+					response.Answers = append(response.Answers, dnsmessage.Resource{Header: dnsmessage.ResourceHeader{Name: question.Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET, TTL: 1}, Body: &dnsmessage.AResource{A: ip}})
+				}
+				if question.Type == dnsmessage.TypeAAAA && serverIP.Is6() {
+					ip := serverIP.As16()
+					if question.Name.String() == "blocked.test." {
+						ip = netip.MustParseAddr("2001:db8::50").As16()
+					}
+					response.Answers = append(response.Answers, dnsmessage.Resource{Header: dnsmessage.ResourceHeader{Name: question.Name, Type: dnsmessage.TypeAAAA, Class: dnsmessage.ClassINET, TTL: 1}, Body: &dnsmessage.AAAAResource{AAAA: ip}})
+				}
+			}
+			encoded, err := response.Pack()
+			if err == nil {
+				_, _ = dns.WriteTo(encoded, client)
+			}
+		}
+	}()
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		p.requests.Add(1)
+		if r.Header.Get("Proxy-Authorization") != "" || r.Header.Get("Proxy-Connection") != "" || r.Header.Get("X-Hop-Only") != "" {
+			p.authLeaked.Store(true)
+		}
+		if r.URL.Path == "/stream" {
+			_, _ = w.Write(bytes.Repeat([]byte("wireguard-stream\n"), 65536))
+			return
+		}
+		if r.Method == http.MethodPost {
+			_, _ = io.Copy(w, r.Body)
+			return
+		}
+		_, _ = io.WriteString(w, "hello over encrypted WireGuard")
+	})
+	httpListener, err := stack.ListenTCPAddrPort(netip.AddrPortFrom(serverIP, 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, p.httpPort, _ = net.SplitHostPort(httpListener.Addr().String())
+	httpServer := &http.Server{Handler: handler, ReadHeaderTimeout: 5 * time.Second, ErrorLog: log.New(io.Discard, "", 0)}
+	t.Cleanup(func() { _ = httpServer.Close() })
+	go func() { _ = httpServer.Serve(httpListener) }()
+	tlsCert, roots := makeTestCertificate(t)
+	p.certificates = roots
+	tlsListener, err := stack.ListenTCPAddrPort(netip.AddrPortFrom(serverIP, 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, p.httpsPort, _ = net.SplitHostPort(tlsListener.Addr().String())
+	httpsServer := &http.Server{Handler: handler, ReadHeaderTimeout: 5 * time.Second, ErrorLog: log.New(io.Discard, "", 0)}
+	t.Cleanup(func() { _ = httpsServer.Close() })
+	go func() {
+		_ = httpsServer.Serve(tls.NewListener(tlsListener, &tls.Config{Certificates: []tls.Certificate{tlsCert}, MinVersion: tls.VersionTLS12}))
+	}()
+	return p
+}
+
+func makeTestCertificate(t *testing.T) (tls.Certificate, *x509.CertPool) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "media.test"}, DNSNames: []string{"media.test"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	certDER, err := x509.CreateCertificate(rand.Reader, &template, &template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDER, err := x509.MarshalECPrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certDER})
+	cert, err := tls.X509KeyPair(certPEM, pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: keyDER}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AppendCertsFromPEM(certPEM)
+	return cert, roots
+}
+
+func proxyClient(t *testing.T, e *Engine, roots *x509.CertPool) *http.Client {
+	t.Helper()
+	proxyURL := &url.URL{Scheme: "http", Host: net.JoinHostPort("127.0.0.1", strconv.Itoa(e.Port())), User: url.UserPassword(testUser, testPassword)}
+	transport := &http.Transport{Proxy: http.ProxyURL(proxyURL), TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}}
+	t.Cleanup(transport.CloseIdleConnections)
+	return &http.Client{Transport: transport, Timeout: 10 * time.Second}
+}
+
+func readResponse(t *testing.T, client *http.Client, address string) string {
+	t.Helper()
+	response, err := client.Get(address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.StatusCode != http.StatusOK {
+		t.Fatalf("unexpected status %d: %s", response.StatusCode, body)
+	}
+	return string(body)
+}
+
+func TestWireGuardEndToEndHTTPDNSAndTLS(t *testing.T) {
