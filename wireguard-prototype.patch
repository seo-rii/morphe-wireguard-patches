@@ -0,0 +1,37 @@
+package app.morphe.patches.shared.misc.wireguard
+
+/** Native payload validation before a modified APK is produced. */
+internal object WireGuardNativePayload {
+    val supportedAbis = setOf("arm64-v8a", "x86_64")
+
+    fun selectAbis(apkEntries: Iterable<String>): Set<String> {
+        val abis = apkEntries.mapNotNull { path ->
+            val parts = path.split('/')
+            if (parts.size == 3 && parts[0] == "lib" && parts[2].endsWith(".so")) parts[1] else null
+        }.toSet()
+        require(abis.isNotEmpty()) {
+            "Cannot determine the APK architecture. Use a complete arm64-v8a or x86_64 APK for the selected app."
+        }
+        val unsupported = abis - supportedAbis
+        require(unsupported.isEmpty()) {
+            "WireGuard preview supports only 64-bit APKs. Unsupported architectures: " +
+                    unsupported.sorted().joinToString() + ". Select an arm64-v8a or x86_64 APK."
+        }
+        return abis
+    }
+
+    fun validateElf(abi: String, bytes: ByteArray) {
+        require(abi in supportedAbis) { "Unsupported native architecture: $abi" }
+        require(bytes.size >= 64 && bytes[0] == 0x7f.toByte() &&
+                bytes[1] == 'E'.code.toByte() && bytes[2] == 'L'.code.toByte() &&
+                bytes[3] == 'F'.code.toByte()) { "WireGuard payload is not an ELF library" }
+        require(bytes[4] == 2.toByte() && bytes[5] == 1.toByte()) {
+            "WireGuard payload must be little-endian ELF64"
+        }
+        fun word(offset: Int) = (bytes[offset].toInt() and 0xff) or
+                ((bytes[offset + 1].toInt() and 0xff) shl 8)
+        require(word(16) == 3) { "WireGuard payload must be a shared library" }
+        val expectedMachine = if (abi == "arm64-v8a") 183 else 62
+        require(word(18) == expectedMachine) { "WireGuard payload architecture does not match $abi" }
+    }
+}
diff --git a/patches/src/main/kotlin/app/morphe/patches/shared/misc/wireguard/WireGuardRuntime.kt b/patches/src/main/kotlin/app/morphe/patches/shared/misc/wireguard/WireGuardRuntime.kt
new file mode 100644
index 0000000000000000000000000000000000000000..61a26b42d74bf456727c8bcb3a38e8de57af7d93
--- /dev/null
+++ b/patches/src/main/kotlin/app/morphe/patches/shared/misc/wireguard/WireGuardRuntime.kt
@@ -0,0 +1,70 @@
+package app.morphe.patches.shared.misc.wireguard
+
+import app.morphe.patcher.Fingerprint
+import app.morphe.patcher.patch.PatchException
+import app.morphe.patcher.patch.listApkEntries
+import app.morphe.patcher.patch.resourceFile
+import app.morphe.patcher.patch.resourceXml
+import app.morphe.patcher.util.returnEarly
+import app.morphe.patches.shared.misc.settings.preference.BasePreferenceScreen
+import app.morphe.patches.shared.misc.settings.preference.NonInteractivePreference
+import app.morphe.util.inputStreamFromBundledResource
+
+private object WireGuardIncludedFingerprint : Fingerprint(
+    definingClass = "Lapp/morphe/extension/shared/wireguard/WireGuardProxy;",
+    name = "isPatchIncluded",
+    returnType = "Z",
+    parameters = emptyList(),
+)
+
+/** Shared installation only; each app declares its own network hooks and compatibility. */
+internal fun installWireGuardRuntime(preferenceScreen: BasePreferenceScreen.Screen) {
+    // Resolve all inputs before changing the APK. Never produce a patch with a missing engine.
+    val payloads = try {
+        WireGuardNativePayload.selectAbis(listApkEntries("lib/")).associateWith { abi ->
+            val bytes = inputStreamFromBundledResource("wireguard", "$abi/libmorphewireguard.so")
+                ?.use { it.readBytes() }
+                ?: throw PatchException(
+                    "Missing WireGuard engine for $abi. Run scripts/build-wireguard-android.sh " +
+                            "before building this patch bundle."
+                )
+            WireGuardNativePayload.validateElf(abi, bytes)
+            bytes
+        }
+    } catch (exception: IllegalArgumentException) {
+        throw PatchException(exception.message ?: "Invalid WireGuard native payload")
+    }
+
+    // The same bundle can patch different app APKs in one JVM. Do not reuse a previous match.
+    WireGuardIncludedFingerprint.clearMatch()
+    WireGuardIncludedFingerprint.method.returnEarly(true)
+
+    payloads.forEach { (abi, bytes) ->
+        resourceFile("lib/$abi/libmorphewireguard.so", copy = false).apply {
+            parentFile.mkdirs()
+            writeBytes(bytes)
+        }
+    }
+
+    resourceXml("AndroidManifest.xml").use { manifest ->
+        val application = manifest.elements("application").first()
+        // The payload is copied as an APK file, not through an Android Gradle jniLibs merge.
+        // Extraction lets System.loadLibrary load it even if the APK writer compresses it.
+        application.setAttribute("android:extractNativeLibs", "true")
+        application.appendChild("activity") {
+            setAttribute("android:name", "app.morphe.extension.shared.wireguard.WireGuardSettingsActivity")
+            setAttribute("android:exported", "false")
+            setAttribute("android:excludeFromRecents", "true")
+            setAttribute("android:theme", "@android:style/Theme.Material")
+            setAttribute("android:label", "@string/morphe_wireguard_settings_title")
+        }
+    }
+
+    preferenceScreen.addPreferences(
+        NonInteractivePreference(
+            key = "morphe_wireguard_settings",
+            tag = "app.morphe.extension.shared.wireguard.WireGuardPreference",
+            selectable = true,
+        )
+    )
+}
