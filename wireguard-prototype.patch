diff --git a/native/wireguard/lifecycle_test.go b/native/wireguard/lifecycle_test.go
new file mode 100644
index 000000000..542e39a13
--- /dev/null
+++ b/native/wireguard/lifecycle_test.go
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golang.zx2c4.com/wireguard/conn"
+	"golang.zx2c4.com/wireguard/conn/bindtest"
+)
+
+// Only test outer packets are dropped. Production keeps the upstream UDP bind.
+type packetDropBind struct {
+	conn.Bind
+	drop atomic.Bool
+	sent chan struct{}
+}
+
+func (b *packetDropBind) Send(packets [][]byte, endpoint conn.Endpoint) error {
+	select {
+	case b.sent <- struct{}{}:
+	default:
+	}
+	if b.drop.Load() {
+		return nil
+	}
+	return b.Bind.Send(packets, endpoint)
+}
+
+func TestMemoryRecoversAfterOuterPacketLoss(t *testing.T) {
+	binds := bindtest.NewChannelBinds()
+	clientBind := &packetDropBind{Bind: binds[1]}
+	peer := newTestPeerWithBind(t, binds[0], clientBind, false)
+	engine := peer.start(t)
+	client := proxyClient(t, engine, nil)
+	client.Transport.(*http.Transport).DisableKeepAlives = true
+	address := "http://media.test:" + peer.httpPort + "/"
+	readResponse(t, client, address)
+	requestsBefore := peer.requests.Load()
+	clientBind.drop.Store(true)
+	ctx, cancel := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	defer cancel()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, address, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := client.Do(request)
+	if response != nil {
+		_, _ = io.Copy(io.Discard, response.Body)
+		response.Body.Close()
+	}
+	if err == nil || peer.requests.Load() != requestsBefore {
+		t.Fatal("request did not stop when outer WireGuard packets were dropped")
+	}
+	clientBind.drop.Store(false)
+	if got := readResponse(t, client, address); got != "hello over encrypted WireGuard" {
+		t.Fatal("encrypted traffic did not recover after packet delivery resumed")
+	}
+}
+
+func TestMemoryStopCancelsPendingDialAndReleasesListener(t *testing.T) {
+	binds := bindtest.NewChannelBinds()
+	clientBind := &packetDropBind{Bind: binds[0], sent: make(chan struct{}, 1)}
+	clientBind.drop.Store(true)
+	engine, err := startWithBind(fixtureConfig(), testUser, testPassword, 0, clientBind)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer engine.Close()
+	dialDone := make(chan error, 1)
+	go func() {
+		connection, err := engine.dialContext(context.Background(), "tcp", "10.77.0.1:80")
+		if connection != nil {
+			connection.Close()
+		}
+		dialDone <- err
+	}()
+	select {
+	case <-clientBind.sent:
+	case <-time.After(3 * time.Second):
+		t.Fatal("pending connection never attempted a WireGuard packet")
+	}
+	closed := make(chan struct{})
+	go func() {
+		engine.Close()
+		close(closed)
+	}()
+	select {
+	case <-closed:
+	case <-time.After(3 * time.Second):
+		t.Fatal("stop did not finish with an unreachable peer")
+	}
+	select {
+	case err := <-dialDone:
+		if err == nil {
+			t.Fatal("pending connection succeeded after stop")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("stop did not cancel the pending userspace connection")
+	}
+	if _, err := engine.dialContext(context.Background(), "tcp", "10.77.0.1:80"); !errors.Is(err, errClosed) {
+		t.Fatal("stopped engine accepted a new connection")
+	}
+	listener, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(engine.Port())))
+	if err != nil {
+		t.Fatal("stop did not release the local listener")
+	}
+	listener.Close()
+}
diff --git a/native/wireguard/proxy.go b/native/wireguard/proxy.go
new file mode 100644
index 000000000..0cdec96cb
--- /dev/null
+++ b/native/wireguard/proxy.go
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"crypto/sha256"
+	"crypto/subtle"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+)
+
+func (e *Engine) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	// Error responses are bounded too; successful streaming responses refresh
+	// the deadline on each write rather than imposing a maximum video length.
+	_ = http.NewResponseController(w).SetWriteDeadline(time.Now().Add(idleTimeout))
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || host != "127.0.0.1" {
+		http.Error(w, "Loopback clients only", http.StatusForbidden)
+		return
+	}
+	// Comparing hashes is length-independent and keeps authentication checks
+	// constant-time. Never log requests, authorization headers, or raw errors.
+	provided := sha256.Sum256([]byte(r.Header.Get("Proxy-Authorization")))
+	if subtle.ConstantTimeCompare(provided[:], e.authDigest[:]) != 1 {
+		w.Header().Set("Proxy-Authenticate", `Basic realm="App WireGuard"`)
+		w.Header().Set("Connection", "close")
+		http.Error(w, "Proxy authentication required", http.StatusProxyAuthRequired)
+		return
+	}
+	if e.ctx.Err() != nil {
+		http.Error(w, "WireGuard proxy is stopped", http.StatusServiceUnavailable)
+		return
+	}
+	if r.Method == http.MethodConnect {
+		e.connect(w, r)
+		return
+	}
+	e.forwardHTTP(w, r)
+}
+
+func (e *Engine) connect(w http.ResponseWriter, r *http.Request) {
+	// CONNECT carries bytes end-to-end; no TLS interception, certificate changes,
+	// SOCKS/UDP shim, or HTTP/3 traffic is provided by this implementation.
+	if r.ContentLength > 0 || len(r.TransferEncoding) != 0 || r.URL.Path != "" || r.URL.RawQuery != "" || r.URL.User != nil {
+		http.Error(w, "Invalid CONNECT request", http.StatusBadRequest)
+		return
+	}
+	destination := r.Host
+	if _, _, err := net.SplitHostPort(destination); err != nil {
+		http.Error(w, "CONNECT requires host:port", http.StatusBadRequest)
+		return
+	}
+	upstream, err := e.dialContext(r.Context(), "tcp", destination)
+	if err != nil {
+		http.Error(w, "WireGuard connection unavailable", http.StatusBadGateway)
+		return
+	}
+	defer upstream.Close()
+	hijacker, ok := w.(http.Hijacker)
+	if !ok {
+		http.Error(w, "CONNECT is unavailable", http.StatusInternalServerError)
+		return
+	}
+	client, buffered, err := hijacker.Hijack()
+	if err != nil {
+		return
+	}
+	defer func() {
+		_ = client.Close()
+		e.untrack(client)
+	}()
+	_ = client.SetDeadline(time.Now().Add(idleTimeout))
+	if _, err := buffered.WriteString("HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
+		return
+	}
+	if err := buffered.Flush(); err != nil {
+		return
+	}
+	clientIO := &idleConn{Conn: client, timeout: idleTimeout}
+	// Drain only bytes already buffered by net/http, then use the wrapper for
+	// socket reads so a stalled client cannot leave an unbounded blocked read.
+	clientInput := io.MultiReader(io.LimitReader(buffered.Reader, int64(buffered.Reader.Buffered())), clientIO)
+	var copies sync.WaitGroup
+	copies.Add(2)
+	go func() {
+		defer copies.Done()
+		if _, err := io.Copy(upstream, clientInput); err != nil {
+			_ = upstream.Close()
+			_ = client.Close()
+			return
+		}
+		closeWrite(upstream)
+	}()
+	go func() {
+		defer copies.Done()
+		if _, err := io.Copy(clientIO, upstream); err != nil {
+			_ = upstream.Close()
+			_ = client.Close()
+			return
+		}
+		closeWrite(client)
+	}()
+	copies.Wait()
+}
+
+func closeWrite(c net.Conn) {
+	if half, ok := c.(interface{ CloseWrite() error }); ok {
+		_ = half.CloseWrite()
+	} else {
+		_ = c.Close()
+	}
+}
+
+// net/http no longer owns a CONNECT socket after Hijack. Both directions need
+// deadlines: an upstream read deadline cannot interrupt a blocked client write.
+type idleConn struct {
+	net.Conn
+	timeout time.Duration
+}
+
+func (c *idleConn) Read(p []byte) (int, error) {
+	c.touch()
+	n, err := c.Conn.Read(p)
+	if n > 0 {
+		c.touch()
+	}
+	return n, err
+}
+
+func (c *idleConn) Write(p []byte) (int, error) {
+	c.touch()
+	n, err := c.Conn.Write(p)
+	if n > 0 {
+		c.touch()
+	}
+	return n, err
+}
+
+func (c *idleConn) touch() {
+	// Idle is connection-wide, not direction-wide. A long video download has
+	// a blocked client read while its writes stay active; expiring that read
+	// would incorrectly abort a healthy stream. net.Conn permits concurrent
+	// deadline updates and applies them to operations already blocked in I/O.
+	_ = c.Conn.SetDeadline(time.Now().Add(c.timeout))
+}
+
+type deadlineBody struct {
+	io.ReadCloser
+	controller *http.ResponseController
+}
+
+func (b *deadlineBody) Read(p []byte) (int, error) {
+	_ = b.controller.SetReadDeadline(time.Now().Add(idleTimeout))
+	return b.ReadCloser.Read(p)
+}
+
+type deadlineWriter struct {
+	writer     io.Writer
+	controller *http.ResponseController
+}
+
+func (w *deadlineWriter) Write(p []byte) (int, error) {
+	_ = w.controller.SetWriteDeadline(time.Now().Add(idleTimeout))
+	return w.writer.Write(p)
+}
+
+func (e *Engine) forwardHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Scheme != "http" || r.URL.Host == "" || r.URL.User != nil || r.Header.Get("Upgrade") != "" {
+		http.Error(w, "Use an absolute HTTP URL or CONNECT", http.StatusBadRequest)
+		return
+	}
+	outgoing := r.Clone(r.Context())
+	outgoing.RequestURI = ""
+	outgoing.Header = r.Header.Clone()
+	controller := http.NewResponseController(w)
+	if outgoing.Body != nil {
+		outgoing.Body = &deadlineBody{ReadCloser: outgoing.Body, controller: controller}
+	}
+	stripHopHeaders(outgoing.Header)
+	outgoing.Header.Del("Proxy-Authorization")
+	outgoing.Header.Del("Proxy-Authenticate")
+	response, err := e.transport.RoundTrip(outgoing)
+	if err != nil {
+		http.Error(w, "WireGuard request unavailable", http.StatusBadGateway)
+		return
+	}
+	defer response.Body.Close()
+	stripHopHeaders(response.Header)
+	for name, values := range response.Header {
+		for _, value := range values {
+			w.Header().Add(name, value)
+		}
+	}
+	w.WriteHeader(response.StatusCode)
+	if _, err := io.Copy(&deadlineWriter{writer: w, controller: controller}, response.Body); err != nil {
+		// Headers may already be sent. Abort instead of completing a truncated response.
+		panic(http.ErrAbortHandler)
+	}
+}
+
+func stripHopHeaders(h http.Header) {
+	for _, value := range h.Values("Connection") {
+		for _, field := range strings.Split(value, ",") {
+			h.Del(strings.TrimSpace(field))
+		}
+	}
+	for _, field := range []string{"Connection", "Proxy-Connection", "Keep-Alive", "Proxy-Authenticate", "Proxy-Authorization", "TE", "Trailer", "Transfer-Encoding", "Upgrade"} {
+		h.Del(field)
+	}
+}
diff --git a/native/wireguard/proxy_test.go b/native/wireguard/proxy_test.go
new file mode 100644
index 000000000..68e805292
--- /dev/null
+++ b/native/wireguard/proxy_test.go
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"bufio"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestProxyResponseBodyCompletion(t *testing.T) {
+	for _, scheme := range []string{"http", "https"} {
+		for _, tc := range []struct {
+			name     string
+			body     string
+			complete bool
+		}{
+			{"complete-small", "hello", true},
+			{"truncated-small", "hello", false},
+			{"complete-stream", strings.Repeat("x", 8192), true},
+			{"truncated-stream", strings.Repeat("x", 8192), false},
+		} {
+			t.Run(scheme+"/"+tc.name, func(t *testing.T) {
+				peer := newMemoryTestPeer(t)
+				listener, err := peer.stack.ListenTCPAddrPort(netip.MustParseAddrPort("10.77.0.1:0"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer listener.Close()
+				cert, roots := makeTestCertificate(t)
+				var origin net.Listener = listener
+				if scheme == "https" {
+					origin = tls.NewListener(listener, &tls.Config{Certificates: []tls.Certificate{cert}, MinVersion: tls.VersionTLS12})
+				}
+				originDone := make(chan error, 1)
+				go func() {
+					connection, err := origin.Accept()
+					if err != nil {
+						originDone <- err
+						return
+					}
+					defer connection.Close()
+					_ = connection.SetDeadline(time.Now().Add(5 * time.Second))
+					request, err := http.ReadRequest(bufio.NewReader(connection))
+					if err != nil {
+						originDone <- err
+						return
+					}
+					_ = request.Body.Close()
+					ending := ""
+					if tc.complete {
+						ending = "0\r\n\r\n"
+					}
+					// Closing without the final chunk simulates an interrupted origin.
+					_, err = fmt.Fprintf(connection, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n%x\r\n%s\r\n%s", len(tc.body), tc.body, ending)
+					originDone <- err
+				}()
+				engine := peer.start(t)
+				client := proxyClient(t, engine, roots)
+				_, port, err := net.SplitHostPort(listener.Addr().String())
+				if err != nil {
+					t.Fatal(err)
+				}
+				response, requestErr := client.Get(scheme + "://media.test:" + port + "/")
+				select {
+				case err := <-originDone:
+					if err != nil {
+						t.Fatalf("origin failed to send test response: %v", err)
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatal("origin did not finish sending test response")
+				}
+				if requestErr != nil {
+					// An abort before a small HTTP response is flushed closes the
+					// connection before the client can read any response headers.
+					if scheme == "http" && !tc.complete && tc.name == "truncated-small" && errors.Is(requestErr, io.EOF) {
+						return
+					}
+					t.Fatal(requestErr)
+				}
+				defer response.Body.Close()
+				body, readErr := io.ReadAll(response.Body)
+				if response.StatusCode != http.StatusOK || !strings.HasPrefix(tc.body, string(body)) {
+					t.Fatalf("unexpected response: status=%d bytes=%d", response.StatusCode, len(body))
+				}
+				if tc.complete && (readErr != nil || string(body) != tc.body) {
+					t.Fatalf("complete response failed: bytes=%d error=%v", len(body), readErr)
+				}
+				if !tc.complete && (len(body) == 0 || !errors.Is(readErr, io.ErrUnexpectedEOF)) {
+					t.Fatalf("truncated response must fail the client read: bytes=%d error=%v", len(body), readErr)
+				}
+			})
+		}
+	}
+}
+
+func TestIdleClientReadAndWriteAreBounded(t *testing.T) {
+	for _, operation := range []string{"read", "write"} {
+		t.Run(operation, func(t *testing.T) {
+			client, other := net.Pipe()
+			defer client.Close()
+			defer other.Close()
+			wrapped := &idleConn{Conn: client, timeout: 25 * time.Millisecond}
+			start := time.Now()
+			var err error
+			if operation == "read" {
+				_, err = wrapped.Read(make([]byte, 1))
+			} else {
+				// The peer deliberately never reads, just like an authenticated
+				// local client that abandons a CONNECT response body.
+				_, err = wrapped.Write([]byte("unread CONNECT data"))
+			}
+			if timeout, ok := err.(net.Error); !ok || !timeout.Timeout() {
+				t.Fatalf("expected bounded idle timeout, got %v", err)
+			}
+			if time.Since(start) > time.Second {
+				t.Fatal("idle operation was not interrupted promptly")
+			}
+		})
+	}
+}
+
+func TestIdleDeadlineTracksActivityInEitherDirection(t *testing.T) {
+	client, other := net.Pipe()
+	defer client.Close()
+	defer other.Close()
+	// A one-second margin keeps this real-time regression reliable while race
+	// instrumentation and parallel native builds compete for CPU time.
+	wrapped := &idleConn{Conn: client, timeout: time.Second}
+	readDone := make(chan error, 1)
+	go func() {
+		_, err := wrapped.Read(make([]byte, 1))
+		readDone <- err
+	}()
+	go func() { _, _ = io.Copy(io.Discard, other) }()
+	// The client never sends additional request data, while response writes
+	// keep flowing for longer than one timeout interval.
+	for i := 0; i < 20; i++ {
+		time.Sleep(60 * time.Millisecond)
+		if _, err := wrapped.Write([]byte{1}); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case err := <-readDone:
+			t.Fatalf("active one-way stream expired: %v", err)
+		default:
+		}
+	}
+	select {
+	case err := <-readDone:
+		if timeout, ok := err.(net.Error); !ok || !timeout.Timeout() {
+			t.Fatalf("fully idle stream did not time out: %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("fully idle connection stayed open")
+	}
+}
+
+func TestIdleClientDeadlineSlides(t *testing.T) {
+	client, other := net.Pipe()
+	defer client.Close()
+	defer other.Close()
+	wrapped := &idleConn{Conn: client, timeout: time.Second}
+	go func() {
+		for i := 0; i < 20; i++ {
+			time.Sleep(60 * time.Millisecond)
+			if _, err := other.Write([]byte{1}); err != nil {
+				return
+			}
+		}
+	}()
+	for i := 0; i < 20; i++ {
+		if _, err := wrapped.Read(make([]byte, 1)); err != nil {
+			t.Fatalf("active stream should outlive one idle interval: %v", err)
+		}
+	}
+}
diff --git a/native/wireguard/shutdown_test.go b/native/wireguard/shutdown_test.go
new file mode 100644
index 000000000..709ee33da
--- /dev/null
+++ b/native/wireguard/shutdown_test.go
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"context"
+	"net/netip"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+// gatedShutdownTUN holds a real peer receiver inside Write. Its own Close waits
+// for writes so a failing ordering assertion cannot trigger the upstream race.
+type gatedShutdownTUN struct {
+	tun.Device
+	mu            sync.RWMutex
+	writeOnce     sync.Once
+	releaseOnce   sync.Once
+	closeOnce     sync.Once
+	writeStarted  chan struct{}
+	writeReleased chan struct{}
+	writeFinished chan struct{}
+	closeStarted  chan struct{}
+	closeErr      error
+}
+
+func (g *gatedShutdownTUN) Write(buffers [][]byte, offset int) (int, error) {
+	g.mu.RLock()
+	defer g.mu.RUnlock()
+	first := false
+	g.writeOnce.Do(func() {
+		first = true
+		close(g.writeStarted)
+		<-g.writeReleased
+	})
+	n, err := g.Device.Write(buffers, offset)
+	if first {
+		close(g.writeFinished)
+	}
+	return n, err
+}
+
+func (g *gatedShutdownTUN) releaseWrite() {
+	g.releaseOnce.Do(func() { close(g.writeReleased) })
+}
+
+func (g *gatedShutdownTUN) Close() error {
+	g.closeOnce.Do(func() {
+		close(g.closeStarted)
+		g.mu.Lock()
+		defer g.mu.Unlock()
+		g.closeErr = g.Device.Close()
+	})
+	return g.closeErr
+}
+
+func TestShutdownWaitsForPeerReceiverBeforeClosingTUN(t *testing.T) {
+	peer := newMemoryTestPeer(t)
+	config, err := parseConfig(peer.config)
+	if err != nil {
+		t.Fatal("could not parse generated test profile")
+	}
+	defer config.clearKeys()
+	base, stack, err := netstack.CreateNetTUN(config.addresses, config.dns, config.mtu)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gated := &gatedShutdownTUN{
+		Device: base, writeStarted: make(chan struct{}), writeReleased: make(chan struct{}),
+		writeFinished: make(chan struct{}), closeStarted: make(chan struct{}),
+	}
+	dev := device.NewDevice(gated, peer.clientBind, device.NewLogger(device.LogLevelSilent, ""))
+	t.Cleanup(func() {
+		gated.releaseWrite()
+		closeWireGuardDevice(dev)
+	})
+	if err := dev.IpcSet(config.uapi()); err != nil {
+		t.Fatal("could not configure generated test peer")
+	}
+	if err := dev.Up(); err != nil {
+		t.Fatal(err)
+	}
+	port, err := strconv.ParseUint(peer.httpPort, 10, 16)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	dialDone := make(chan struct{})
+	go func() {
+		defer close(dialDone)
+		connection, _ := stack.DialContextTCPAddrPort(ctx, netip.AddrPortFrom(netip.MustParseAddr("10.77.0.1"), uint16(port)))
+		if connection != nil {
+			_ = connection.Close()
+		}
+	}()
+	awaitShutdownSignal(t, "peer receiver entering TUN.Write", gated.writeStarted)
+	// Cancel the pending virtual connection before shutdown. Releasing the peer's
+	// reply then exercises the same reset-generation path seen in the CI race.
+	cancel()
+	awaitShutdownSignal(t, "pending dial cancellation", dialDone)
+	shutdownStarted, shutdownDone := make(chan struct{}), make(chan struct{})
+	go func() {
+		close(shutdownStarted)
+		closeWireGuardDevice(dev)
+		close(shutdownDone)
+	}()
+	awaitShutdownSignal(t, "shutdown invocation", shutdownStarted)
+	closedEarly := false
+	select {
+	case <-gated.closeStarted:
+		closedEarly = true
+	case <-time.After(100 * time.Millisecond):
+	}
+	gated.releaseWrite()
+	awaitShutdownSignal(t, "peer receiver finishing TUN.Write", gated.writeFinished)
+	awaitShutdownSignal(t, "device shutdown", shutdownDone)
+	if closedEarly {
+		t.Fatal("TUN.Close started while a peer receiver was still inside TUN.Write")
+	}
+}
+
+func awaitShutdownSignal(t *testing.T, operation string, signal <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-signal:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("timed out waiting for %s", operation)
+	}
+}
