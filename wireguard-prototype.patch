--- /dev/null
+++ b/native/wireguard/cmd/jni/jni.c
@@ -0,0 +1,134 @@
+//go:build android || jni
+
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include <jni.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "_cgo_export.h"
+
+static void throw_error(JNIEnv *env, const char *type, const char *message) {
+    if ((*env)->ExceptionCheck(env)) return;
+    jclass exception = (*env)->FindClass(env, type);
+    if (exception != NULL) {
+        (*env)->ThrowNew(env, exception, message);
+        (*env)->DeleteLocalRef(env, exception);
+    }
+}
+
+static void free_text(char *text) {
+    if (text == NULL) return;
+    size_t length = strlen(text);
+    volatile char *bytes = (volatile char *) text;
+    while (length != 0) bytes[--length] = 0;
+    free(text);
+}
+
+// JNI's GetStringUTFChars uses modified UTF-8, including CESU-8 surrogate
+// pairs. Decode UTF-16 explicitly so valid non-BMP profile comments round-trip
+// as ordinary UTF-8. Reject embedded NUL and unpaired surrogates, never truncate.
+static char *read_utf8(JNIEnv *env, jstring value, size_t max_bytes) {
+    if (value == NULL || (size_t) (*env)->GetStringLength(env, value) > max_bytes) {
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid or oversized WireGuard input.");
+        return NULL;
+    }
+    jsize length = (*env)->GetStringLength(env, value);
+    const jchar *chars = (*env)->GetStringChars(env, value, NULL);
+    if (chars == NULL) return NULL;
+    char *result = (char *) malloc(max_bytes + 1);
+    if (result == NULL) {
+        (*env)->ReleaseStringChars(env, value, chars);
+        throw_error(env, "java/lang/OutOfMemoryError", "Could not allocate WireGuard input.");
+        return NULL;
+    }
+    size_t offset = 0;
+    int valid = 1;
+    for (jsize i = 0; i < length; ++i) {
+        uint32_t code = chars[i];
+        if (code >= 0xd800 && code <= 0xdbff) {
+            if (++i >= length || chars[i] < 0xdc00 || chars[i] > 0xdfff) {
+                valid = 0;
+                break;
+            }
+            code = 0x10000 + ((code - 0xd800) << 10) + (chars[i] - 0xdc00);
+        } else if (code == 0 || (code >= 0xdc00 && code <= 0xdfff)) {
+            valid = 0;
+            break;
+        }
+        size_t count = code < 0x80 ? 1 : code < 0x800 ? 2 : code < 0x10000 ? 3 : 4;
+        if (offset + count > max_bytes) {
+            valid = 0;
+            break;
+        }
+        if (count == 1) {
+            result[offset++] = (char) code;
+        } else {
+            const unsigned char prefix[] = {0, 0, 0xc0, 0xe0, 0xf0};
+            result[offset++] = (char) (prefix[count] | (code >> (6 * (count - 1))));
+            for (size_t remaining = count - 1; remaining != 0; --remaining) {
+                result[offset++] = (char) (0x80 | ((code >> (6 * (remaining - 1))) & 0x3f));
+            }
+        }
+    }
+    result[offset] = '\0';
+    (*env)->ReleaseStringChars(env, value, chars);
+    if (!valid) {
+        free_text(result);
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid or oversized WireGuard input.");
+        return NULL;
+    }
+    return result;
+}
+
+JNIEXPORT jint JNICALL Java_app_morphe_extension_shared_wireguard_NativeTunnel_start(
+        JNIEnv *env, jclass klass, jstring config, jstring username, jstring password, jint port) {
+    (void) klass;
+    if (port < 0 || port > 65535) {
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid local proxy port.");
+        return -1;
+    }
+    char *conf = read_utf8(env, config, 65536);
+    if (conf == NULL) return -1;
+    char *user = read_utf8(env, username, 128);
+    if (user == NULL) {
+        free_text(conf);
+        return -1;
+    }
+    char *pass = read_utf8(env, password, 256);
+    if (pass == NULL) {
+        free_text(user);
+        free_text(conf);
+        return -1;
+    }
+    int result = morphe_wg_start(conf, user, pass, (int)port);
+    free_text(pass);
+    free_text(user);
+    free_text(conf);
+    if (result == -1) {
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid or unsupported WireGuard configuration.");
+    } else if (result == -2) {
+        throw_error(env, "java/lang/IllegalStateException", "WireGuard proxy is already running.");
+    } else if (result <= 0) {
+        throw_error(env, "java/lang/IllegalStateException", "Could not start the local WireGuard proxy.");
+    }
+    return (jint) result;
+}
+
+JNIEXPORT void JNICALL Java_app_morphe_extension_shared_wireguard_NativeTunnel_stop(JNIEnv *env, jclass klass) {
+    (void) env;
+    (void) klass;
+    morphe_wg_stop();
+}
+
+JNIEXPORT void JNICALL Java_app_morphe_extension_shared_wireguard_NativeTunnel_validate(JNIEnv *env, jclass klass, jstring config) {
+    (void) klass;
+    char *conf = read_utf8(env, config, 65536);
+    if (conf == NULL) return;
+    char *error = morphe_wg_validate(conf);
+    free_text(conf);
+    if (error != NULL) {
+        throw_error(env, "app/morphe/extension/shared/wireguard/NativeTunnel$InvalidProfileException", error);
+        free(error);
+    }
+}
diff --git a/native/wireguard/cmd/jni/main.go b/native/wireguard/cmd/jni/main.go
new file mode 100644
index 000000000..094ff221e
--- /dev/null
+++ b/native/wireguard/cmd/jni/main.go
@@ -0,0 +1,74 @@
+//go:build android || jni
+
+// SPDX-License-Identifier: GPL-3.0-only
+
+// This package is built with -buildmode=c-shared. The C shim exposes the exact
+// NativeTunnel JNI methods; ordinary `go test ./...` tests the core without a JDK.
+package main
+
+/*
+#include <stdlib.h>
+*/
+import "C"
+
+import (
+	"errors"
+	"sync"
+
+	wg "app.morphe/wireguard"
+)
+
+var current struct {
+	sync.Mutex
+	engine *wg.Engine
+}
+
+//export morphe_wg_start
+func morphe_wg_start(config, username, password *C.char, port C.int) (result C.int) {
+	result = -3
+	defer func() {
+		if recover() != nil {
+			result = -3
+		}
+	}()
+	current.Lock()
+	defer current.Unlock()
+	if current.engine != nil {
+		return -2
+	}
+	engine, err := wg.Start(C.GoString(config), C.GoString(username), C.GoString(password), int(port))
+	if err != nil {
+		var configErr *wg.ConfigError
+		if errors.As(err, &configErr) {
+			return -1
+		}
+		return -3
+	}
+	current.engine = engine
+	return C.int(engine.Port())
+}
+
+//export morphe_wg_stop
+func morphe_wg_stop() {
+	current.Lock()
+	defer current.Unlock()
+	if current.engine != nil {
+		current.engine.Close()
+		current.engine = nil
+	}
+}
+
+//export morphe_wg_validate
+func morphe_wg_validate(config *C.char) *C.char {
+	if err := wg.Validate(C.GoString(config)); err != nil {
+		// The Java UI maps only known codes to localized resources.
+		var configErr *wg.ConfigError
+		if errors.As(err, &configErr) {
+			return C.CString(configErr.Code)
+		}
+		return C.CString("invalid_config")
+	}
+	return nil
+}
+
+func main() {}
diff --git a/native/wireguard/config.go b/native/wireguard/config.go
new file mode 100644
index 000000000..8e23df668
--- /dev/null
+++ b/native/wireguard/config.go
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+// Package wireguard provides an app-local, fail-closed WireGuard HTTP proxy.
+// It does not open an operating-system TUN device or change system routing.
+package wireguard
+
+import (
+	"bufio"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net/netip"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+const (
+	MaxConfigBytes = 64 * 1024
+	maxConfigLine  = 4096
+	maxAddresses   = 8
+	maxDNS         = 8
+	maxRoutes      = 256
+)
+
+// ConfigError contains a stable localization code and a value-free diagnostic.
+// JNI returns Code; Error keeps the English diagnostic for non-UI callers.
+type ConfigError struct {
+	Code   string
+	Reason string
+}
+
+func (e *ConfigError) Error() string { return e.Reason }
+
+func invalid(code, reason string) error { return &ConfigError{Code: code, Reason: reason} }
+
+type config struct {
+	privateKey [32]byte
+	publicKey  [32]byte
+	psk        [32]byte
+	hasPSK     bool
+	addresses  []netip.Addr
+	dns        []netip.Addr
+	routes     []netip.Prefix
+	endpoint   netip.AddrPort
+	listenPort uint16
+	keepalive  uint16
+	mtu        int
+}
+
+// Validate checks the supported, single-peer wg-quick .conf subset without
+// starting a listener, resolving names, contacting a peer, or running commands.
+func Validate(text string) error {
+	c, err := parseConfig(text)
+	if c != nil {
+		c.clearKeys()
+	}
+	return err
+}
+
+func parseConfig(text string) (_ *config, resultErr error) {
+	if len(text) == 0 || len(text) > MaxConfigBytes || !utf8.ValidString(text) || strings.ContainsRune(text, '\x00') {
+		return nil, invalid("invalid_text", "Configuration must be valid UTF-8 text of at most 64 KiB.")
+	}
+	text = strings.TrimPrefix(text, "\ufeff")
+	c := &config{mtu: 1420}
+	defer func() {
+		if resultErr != nil {
+			c.clearKeys()
+		}
+	}()
+	section := ""
+	interfaceSeen, peerSeen := false, false
+	seen := make(map[string]bool)
+	scanner := bufio.NewScanner(strings.NewReader(text))
+	scanner.Buffer(make([]byte, 1024), maxConfigLine)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = strings.TrimSpace(line[:i])
+		}
+		if line == "" {
+			continue
+		}
+		if strings.HasPrefix(line, "[") {
+			switch strings.ToLower(line) {
+			case "[interface]":
+				if interfaceSeen || peerSeen {
+					return nil, invalid("invalid_interface", "Exactly one [Interface], followed by one [Peer], is supported.")
+				}
+				interfaceSeen, section = true, "interface"
+			case "[peer]":
+				if !interfaceSeen || peerSeen {
+					return nil, invalid("invalid_peer", "Exactly one [Peer] after [Interface] is supported.")
+				}
+				peerSeen, section = true, "peer"
+			default:
+				return nil, invalid("unsupported_section", "Configuration contains an unsupported section.")
+			}
+			continue
+		}
+		key, value, ok := strings.Cut(line, "=")
+		key, value = strings.ToLower(strings.TrimSpace(key)), strings.TrimSpace(value)
+		if !ok || section == "" || value == "" {
+			return nil, invalid("invalid_directive", "Configuration contains an invalid or empty directive.")
+		}
+		fullKey := section + "." + key
+		multi := fullKey == "interface.address" || fullKey == "interface.dns" || fullKey == "peer.allowedips"
+		if seen[fullKey] && !multi {
+			return nil, invalid("duplicate_directive", "Duplicate singleton directives are not supported.")
+		}
+		seen[fullKey] = true
+		var err error
+		switch fullKey {
+		case "interface.privatekey":
+			c.privateKey, err = parseKey(value, false)
+		case "interface.address":
+			for _, item := range strings.Split(value, ",") {
+				p, parseErr := parsePrefix(strings.TrimSpace(item))
+				if parseErr != nil || !isUnicast(p.Addr()) || len(c.addresses) >= maxAddresses {
+					return nil, invalid("invalid_address", "Address must contain at most 8 unicast IPv4/IPv6 addresses with optional CIDR masks.")
+				}
+				addr := p.Addr().Unmap()
+				if containsAddr(c.addresses, addr) {
+					return nil, invalid("duplicate_address", "Duplicate interface addresses are not supported.")
+				}
+				c.addresses = append(c.addresses, addr)
+			}
+		case "interface.dns":
+			for _, item := range strings.Split(value, ",") {
+				addr, parseErr := netip.ParseAddr(strings.TrimSpace(item))
+				if parseErr != nil || !isUnicast(addr) || len(c.dns) >= maxDNS {
+					return nil, invalid("invalid_dns", "DNS must contain at most 8 numeric unicast IP addresses; search domains are unsupported.")
+				}
+				addr = addr.Unmap()
+				if !containsAddr(c.dns, addr) {
+					c.dns = append(c.dns, addr)
+				}
+			}
+		case "interface.listenport":
+			c.listenPort, err = parseUint16(value)
+		case "interface.mtu":
+			c.mtu, err = strconv.Atoi(value)
+			if err != nil || c.mtu < 576 || c.mtu > 9000 {
+				return nil, invalid("invalid_mtu", "MTU must be between 576 and 9000 bytes.")
+			}
+		case "peer.publickey":
+			c.publicKey, err = parseKey(value, false)
+		case "peer.presharedkey":
+			c.psk, err = parseKey(value, true)
+			c.hasPSK = true
+		case "peer.endpoint":
+			c.endpoint, err = netip.ParseAddrPort(value)
+			if err != nil || !isUnicast(c.endpoint.Addr()) || c.endpoint.Port() == 0 {
+				return nil, invalid("invalid_endpoint", "Endpoint must be numeric IPv4:port or [IPv6]:port. Hostnames are unsupported in this version.")
+			}
+			c.endpoint = netip.AddrPortFrom(c.endpoint.Addr().Unmap(), c.endpoint.Port())
+		case "peer.allowedips":
+			for _, item := range strings.Split(value, ",") {
+				p, parseErr := parsePrefix(strings.TrimSpace(item))
+				if parseErr != nil || p.Addr().Zone() != "" || p.Addr().Is4In6() || len(c.routes) >= maxRoutes {
+					return nil, invalid("invalid_routes", "AllowedIPs must contain at most 256 valid IPv4/IPv6 addresses or CIDR routes.")
+				}
+				c.routes = append(c.routes, p.Masked())
+			}
+		case "peer.persistentkeepalive":
+			if strings.EqualFold(value, "off") {
+				c.keepalive = 0
+			} else {
+				c.keepalive, err = parseUint16(value)
+			}
+		default:
+			// In particular: do not execute PreUp/PostUp/PreDown/PostDown;
+			// do not silently ignore Table, FwMark, SaveConfig or Amnezia keys.
+			return nil, invalid("unsupported_directive", "Unsupported directive. Shell hooks, routing-table options, and non-WireGuard extensions are not accepted.")
+		}
+		if err != nil {
+			return nil, invalid("invalid_value", "A key or numeric configuration value is invalid.")
+		}
+	}
+	if scanner.Err() != nil {
+		return nil, invalid("line_too_long", "Configuration contains a line longer than 4 KiB.")
+	}
+	if !interfaceSeen || !peerSeen || !seen["interface.privatekey"] || !seen["peer.publickey"] || !seen["peer.endpoint"] || len(c.addresses) == 0 || len(c.routes) == 0 {
+		return nil, invalid("missing_required", "PrivateKey, Address, PublicKey, Endpoint and AllowedIPs are required.")
+	}
+	for _, addr := range c.addresses {
+		if addr.Is6() && c.mtu < 1280 {
+			return nil, invalid("ipv6_mtu", "IPv6 requires an MTU of at least 1280 bytes.")
+		}
+	}
+	if len(c.dns) == 0 {
+		return nil, invalid("dns_required", "At least one DNS server is required; system DNS fallback is disabled.")
+	}
+	for _, addr := range c.dns {
+		if !c.hasFamily(addr) || !c.allows(addr) {
+			return nil, invalid("dns_not_routed", "Every DNS server must have a configured address family and be covered by AllowedIPs.")
+		}
+	}
+	return c, nil
+}
+
+// Like wg-quick, a bare numeric address denotes one host, never a subnet.
+func parsePrefix(value string) (netip.Prefix, error) {
+	if strings.Contains(value, "/") {
+		return netip.ParsePrefix(value)
+	}
+	addr, err := netip.ParseAddr(value)
+	if err != nil || addr.Zone() != "" {
+		return netip.Prefix{}, errors.New("invalid address")
+	}
+	return netip.PrefixFrom(addr, addr.BitLen()), nil
+}
+
+func parseKey(value string, allowZero bool) ([32]byte, error) {
+	var key [32]byte
+	decoded, err := base64.StdEncoding.Strict().DecodeString(value)
+	defer clear(decoded)
+	if err != nil || len(decoded) != len(key) {
+		return key, errors.New("invalid key")
+	}
+	copy(key[:], decoded)
+	if !allowZero && key == ([32]byte{}) {
+		return key, errors.New("zero key")
+	}
+	return key, nil
+}
+
+func parseUint16(value string) (uint16, error) {
+	n, err := strconv.ParseUint(value, 10, 16)
+	return uint16(n), err
+}
+
+func isUnicast(addr netip.Addr) bool {
+	if !addr.IsValid() || addr.Zone() != "" {
+		return false
+	}
+	addr = addr.Unmap()
+	return (addr.IsGlobalUnicast() || addr.IsLoopback()) && !addr.IsLinkLocalUnicast()
+}
+
+func containsAddr(addrs []netip.Addr, target netip.Addr) bool {
+	for _, addr := range addrs {
+		if addr == target {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *config) hasFamily(addr netip.Addr) bool {
+	for _, local := range c.addresses {
+		if addr.Is4() == local.Is4() {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *config) allows(addr netip.Addr) bool {
+	addr = addr.Unmap()
+	for _, route := range c.routes {
+		if route.Contains(addr) {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *config) clearKeys() {
+	clear(c.privateKey[:])
+	clear(c.publicKey[:])
+	clear(c.psk[:])
+}
+
+// uapi is internal only: its result includes the private key. Never expose,
+// persist, or log it, and never expose Device.IpcGet() through the JNI API.
+func (c *config) uapi() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "private_key=%s\nlisten_port=%d\nreplace_peers=true\npublic_key=%s\nreplace_allowed_ips=true\nendpoint=%s\npersistent_keepalive_interval=%d\n",
+		hex.EncodeToString(c.privateKey[:]), c.listenPort, hex.EncodeToString(c.publicKey[:]), c.endpoint.String(), c.keepalive)
+	if c.hasPSK {
+		fmt.Fprintf(&b, "preshared_key=%s\n", hex.EncodeToString(c.psk[:]))
+	}
+	for _, prefix := range c.routes {
+		fmt.Fprintf(&b, "allowed_ip=%s\n", prefix.String())
+	}
+	return b.String()
+}
diff --git a/native/wireguard/config_test.go b/native/wireguard/config_test.go
new file mode 100644
index 000000000..7846010fc
--- /dev/null
+++ b/native/wireguard/config_test.go
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"encoding/base64"
+	"errors"
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+func fixtureConfig() string {
+	// Deliberately public synthetic test keys, not real account credentials.
+	private, public := [32]byte{1, 2, 3, 4}, [32]byte{5, 6, 7, 8}
+	return "[Interface]\nPrivateKey = " + base64.StdEncoding.EncodeToString(private[:]) + "\nAddress = 10.77.0.2/32\nDNS = 10.77.0.1\n\n[Peer]\nPublicKey = " + base64.StdEncoding.EncodeToString(public[:]) + "\nEndpoint = 127.0.0.1:51820\nAllowedIPs = 10.77.0.0/24\nPersistentKeepalive = 25\n"
+}
+
+func TestValidateSupportedConfig(t *testing.T) {
+	for _, text := range []string{
+		fixtureConfig(),
+		"# 한글 주석 및 😀 emoji are UTF-8\n" + fixtureConfig(),
+		"\ufeff" + strings.ReplaceAll(fixtureConfig(), "\n", "\r\n"),
+		strings.Replace(fixtureConfig(), "Address = 10.77.0.2/32", "Address = 10.77.0.2/32, fd00:77::2/128\nMTU = 1280", 1),
+		strings.Replace(fixtureConfig(), "Endpoint = 127.0.0.1:51820", "Endpoint = [::1]:51820 # test peer", 1),
+	} {
+		if err := Validate(text); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestValidateStandardKeepaliveOff(t *testing.T) {
+	for _, value := range []string{"off", "OFF", "OfF", "0"} {
+		t.Run(value, func(t *testing.T) {
+			text := strings.Replace(fixtureConfig(), "PersistentKeepalive = 25", "PersistentKeepalive = "+value, 1)
+			c, err := parseConfig(text)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.clearKeys()
+			if c.keepalive != 0 || !strings.Contains(c.uapi(), "persistent_keepalive_interval=0\n") {
+				t.Fatal("off did not disable persistent keepalive")
+			}
+		})
+	}
+}
+
+func TestValidateStandardBareAddresses(t *testing.T) {
+	cases := []struct {
+		name, address string
+		want          []netip.Addr
+	}{
+		{"IPv4", "10.77.0.2", []netip.Addr{netip.MustParseAddr("10.77.0.2")}},
+		{"mixed", "10.77.0.2, fd00:77::2", []netip.Addr{netip.MustParseAddr("10.77.0.2"), netip.MustParseAddr("fd00:77::2")}},
+		{"mixed CIDR", "10.77.0.2/32, fd00:77::2", []netip.Addr{netip.MustParseAddr("10.77.0.2"), netip.MustParseAddr("fd00:77::2")}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			text := strings.Replace(fixtureConfig(), "Address = 10.77.0.2/32", "Address = "+tc.address, 1)
+			c, err := parseConfig(text)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.clearKeys()
+			if len(c.addresses) != len(tc.want) {
+				t.Fatal("interface addresses changed")
+			}
+			for i, want := range tc.want {
+				if c.addresses[i] != want {
+					t.Fatal("interface address changed")
+				}
+			}
+		})
+	}
+}
+
+func TestBareAllowedIPsRemainHostRoutes(t *testing.T) {
+	cases := []struct {
+		name, local, server, adjacent, prefix string
+	}{
+		{"IPv4", "10.77.0.2", "10.77.0.1", "10.77.0.3", "10.77.0.1/32"},
+		{"IPv6", "fd00:77::2", "fd00:77::1", "fd00:77::3", "fd00:77::1/128"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			text := strings.NewReplacer("Address = 10.77.0.2/32", "Address = "+tc.local,
+				"DNS = 10.77.0.1", "DNS = "+tc.server,
+				"AllowedIPs = 10.77.0.0/24", "AllowedIPs = "+tc.server).Replace(fixtureConfig())
+			c, err := parseConfig(text)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.clearKeys()
+			if len(c.routes) != 1 || c.routes[0].String() != tc.prefix ||
+				!c.allows(netip.MustParseAddr(tc.server)) || c.allows(netip.MustParseAddr(tc.adjacent)) ||
+				!strings.Contains(c.uapi(), "allowed_ip="+tc.prefix+"\n") {
+				t.Fatal("bare AllowedIPs expanded beyond its single host")
+			}
+		})
+	}
+}
+
+func TestValidateRejectsUnsupportedOrUnsafeConfig(t *testing.T) {
+	cases := map[string]string{
+		"shell hook":         strings.Replace(fixtureConfig(), "[Peer]", "PostUp = touch /tmp/never-executed\n[Peer]", 1),
+		"routing table":      strings.Replace(fixtureConfig(), "[Peer]", "Table = auto\n[Peer]", 1),
+		"save config":        strings.Replace(fixtureConfig(), "[Peer]", "SaveConfig = true\n[Peer]", 1),
+		"hostname endpoint":  strings.Replace(fixtureConfig(), "127.0.0.1:51820", "vpn.example:51820", 1),
+		"endpoint no port":   strings.Replace(fixtureConfig(), "127.0.0.1:51820", "127.0.0.1", 1),
+		"zero endpoint port": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "127.0.0.1:0", 1),
+		"endpoint multicast": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "224.0.0.1:51820", 1),
+		"endpoint broadcast": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "255.255.255.255:51820", 1),
+		"mapped unspecified": strings.Replace(fixtureConfig(), "127.0.0.1:51820", "[::ffff:0.0.0.0]:51820", 1),
+		"second peer":        fixtureConfig() + "[Peer]\n",
+		"duplicate key":      strings.Replace(fixtureConfig(), "[Peer]", "MTU = 1420\nMTU = 1420\n[Peer]", 1),
+		"out of route DNS":   strings.Replace(fixtureConfig(), "DNS = 10.77.0.1", "DNS = 1.1.1.1", 1),
+		"DNS search domain":  strings.Replace(fixtureConfig(), "DNS = 10.77.0.1", "DNS = private.example", 1),
+		"no DNS":             strings.Replace(fixtureConfig(), "DNS = 10.77.0.1\n", "", 1),
+		"unknown directive":  fixtureConfig() + "Other = 1\n",
+		"invalid range":      strings.Replace(fixtureConfig(), "10.77.0.0/24", "10.77.0.0/33", 1),
+		"missing interface":  strings.Replace(fixtureConfig(), "[Interface]\n", "", 1),
+		"short key":          strings.Replace(fixtureConfig(), "PrivateKey = ", "PrivateKey = BAD", 1),
+		"negative keepalive": strings.Replace(fixtureConfig(), "= 25", "= -1", 1),
+		"invalid off value":  strings.Replace(fixtureConfig(), "= 25", "= offx", 1),
+		"oversize keepalive": strings.Replace(fixtureConfig(), "= 25", "= 65536", 1),
+		"bare address name":  strings.Replace(fixtureConfig(), "10.77.0.2/32", "client.example", 1),
+		"address empty CIDR": strings.Replace(fixtureConfig(), "10.77.0.2/32", "10.77.0.2/", 1),
+		"address empty item": strings.Replace(fixtureConfig(), "10.77.0.2/32", "10.77.0.2,", 1),
+		"bare zoned address": strings.Replace(fixtureConfig(), "10.77.0.2/32", "fd00:77::2%test", 1),
+		"route empty CIDR":   strings.Replace(fixtureConfig(), "10.77.0.0/24", "10.77.0.1/", 1),
+		"bare route name":    strings.Replace(fixtureConfig(), "10.77.0.0/24", "server.example", 1),
+		"bare mapped route":  strings.Replace(fixtureConfig(), "10.77.0.0/24", "::ffff:10.77.0.1", 1),
+		"bare zoned route":   strings.Replace(fixtureConfig(), "10.77.0.0/24", "fd00:77::1%test", 1),
+		"bare route DNS":     strings.Replace(fixtureConfig(), "10.77.0.0/24", "10.77.0.2", 1),
+		"oversized":          strings.Repeat("#", MaxConfigBytes+1),
+		"long line":          strings.Repeat("#", maxConfigLine+1),
+		"embedded NUL":       fixtureConfig() + "\x00",
+		"invalid UTF8":       fixtureConfig() + "\xff",
+	}
+	for name, text := range cases {
+		t.Run(name, func(t *testing.T) {
+			err := Validate(text)
+			if err == nil {
+				t.Fatal("expected rejection")
+			}
+			if strings.Contains(err.Error(), "touch") || strings.Contains(err.Error(), "AQIDBA") || strings.Contains(err.Error(), "vpn.example") {
+				t.Fatal("validation error leaked a config value")
+			}
+		})
+	}
+}
+
+func TestValidationErrorsHaveStableLocalizationCodes(t *testing.T) {
+	config := fixtureConfig()
+	cases := map[string]string{
+		"invalid_text":          config + "\x00",
+		"invalid_interface":     "[Interface]\n" + config,
+		"invalid_peer":          config + "[Peer]\n",
+		"unsupported_section":   strings.Replace(config, "[Interface]", "[Other]", 1),
+		"invalid_directive":     "[Interface]\nPrivateKey = \n",
+		"duplicate_directive":   strings.Replace(config, "[Peer]", "MTU = 1420\nMTU = 1420\n[Peer]", 1),
+		"invalid_address":       strings.Replace(config, "Address = 10.77.0.2/32", "Address = client.invalid", 1),
+		"duplicate_address":     strings.Replace(config, "Address = 10.77.0.2/32", "Address = 10.77.0.2/32, 10.77.0.2/32", 1),
+		"invalid_dns":           strings.Replace(config, "DNS = 10.77.0.1", "DNS = dns.invalid", 1),
+		"invalid_mtu":           strings.Replace(config, "[Peer]", "MTU = 0\n[Peer]", 1),
+		"invalid_endpoint":      strings.Replace(config, "127.0.0.1:51820", "vpn.example:51820", 1),
+		"invalid_routes":        strings.Replace(config, "10.77.0.0/24", "10.77.0.0/33", 1),
+		"unsupported_directive": strings.Replace(config, "[Peer]", "PostUp = secret-hook-marker\n[Peer]", 1),
+		"invalid_value":         strings.Replace(config, "PrivateKey = ", "PrivateKey = BAD", 1),
+		"line_too_long":         config + strings.Repeat("#", maxConfigLine+1),
+		"missing_required":      strings.Replace(config, "PublicKey = ", "# PublicKey = ", 1),
+		"ipv6_mtu": strings.NewReplacer("Address = 10.77.0.2/32", "Address = 10.77.0.2/32, fd00:77::2/128",
+			"[Peer]", "MTU = 1200\n[Peer]").Replace(config),
+		"dns_required":   strings.Replace(config, "DNS = 10.77.0.1\n", "", 1),
+		"dns_not_routed": strings.Replace(config, "DNS = 10.77.0.1", "DNS = 1.1.1.1", 1),
+	}
+	for code, text := range cases {
+		t.Run(code, func(t *testing.T) {
+			err := Validate(text)
+			var configErr *ConfigError
+			if !errors.As(err, &configErr) || configErr.Code != code {
+				t.Fatalf("expected localization code %q, got %v", code, err)
+			}
+			if configErr.Reason == "" || err.Error() != configErr.Reason || configErr.Reason == code {
+				t.Fatal("non-UI diagnostic was lost")
+			}
+			for _, marker := range []string{"secret-hook-marker", "AQIDBA", "vpn.example", "client.invalid", "dns.invalid"} {
+				if strings.Contains(configErr.Code, marker) || strings.Contains(configErr.Reason, marker) {
+					t.Fatal("validation diagnostic contains profile data")
+				}
+			}
+		})
+	}
+}
+
+func TestAllowedIPsAreNotExpanded(t *testing.T) {
+	c, err := parseConfig(fixtureConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.clearKeys()
+	if !c.allows(netip.MustParseAddr("10.77.0.1")) || c.allows(netip.MustParseAddr("8.8.8.8")) {
+		t.Fatal("AllowedIPs policy was not preserved")
+	}
+	if strings.Contains(c.uapi(), "allowed_ip=0.0.0.0/0") {
+		t.Fatal("configuration silently gained a default route")
+	}
+}
+
+func FuzzValidate(f *testing.F) {
+	f.Add(fixtureConfig())
+	f.Add("[Interface]\nPostUp=should-not-run\n")
+	f.Add("")
+	f.Fuzz(func(t *testing.T, text string) {
+		_ = Validate(text)
+	})
+}
diff --git a/native/wireguard/engine.go b/native/wireguard/engine.go
new file mode 100644
index 000000000..1b2d2c5dc
--- /dev/null
+++ b/native/wireguard/engine.go
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+package wireguard
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/net/netutil"
+	"golang.zx2c4.com/wireguard/conn"
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+const (
+	maxConnections = 128
+	dialTimeout    = 20 * time.Second
+	idleTimeout    = 2 * time.Minute
+)
+
+var (
+	errClosed   = errors.New("WireGuard proxy is stopped")
+	errNoRoute  = errors.New("destination is not covered by AllowedIPs")
+	errBadInput = errors.New("invalid proxy destination")
+)
+
+// Engine owns one WireGuard peer and an authenticated, IPv4-loopback-only HTTP
+// proxy. A successful Start means ready to attempt traffic, not an established
+// handshake or verified access to the Internet.
+type Engine struct {
+	config     *config
+	stack      *netstack.Net
+	device     *device.Device
+	server     *http.Server
+	transport  *http.Transport
+	listener   net.Listener
+	port       int
+	authDigest [32]byte
+	ctx        context.Context
+	cancel     context.CancelFunc
+	closeOnce  sync.Once
+	done       chan struct{}
+
+	mu          sync.Mutex
+	closed      bool
+	connections map[net.Conn]struct{}
+}
+
+// Start configures an entirely userspace tunnel and returns a local proxy.
+// Numeric endpoints make startup independent of DNS and peer reachability.
+// listenPort may be zero to request an ephemeral port. Credentials are required
+// because Android apps can access each other's loopback TCP listeners.
+func Start(text, username, password string, listenPort int) (*Engine, error) {
+	return startWithBind(text, username, password, listenPort, conn.NewDefaultBind())
+}
+
+// startWithBind is a private test seam for upstream's in-memory ChannelBind.
+// Production always uses Start's official default UDP transport; there is no
+// alternate transport or permission fallback selected at runtime.
+func startWithBind(text, username, password string, listenPort int, bind conn.Bind) (*Engine, error) {
+	c, err := parseConfig(text)
+	if err != nil {
+		return nil, err
+	}
+	defer c.clearKeys()
+	if !validCredentials(username, password) || listenPort < 0 || listenPort > 65535 {
+		return nil, errors.New("invalid local proxy credentials or port")
+	}
+	tun, stack, err := netstack.CreateNetTUN(c.addresses, c.dns, c.mtu)
+	if err != nil {
+		return nil, errors.New("could not initialize the userspace network stack")
+	}
+	// The default logger is deliberately silent, including UAPI failures.
+	dev := device.NewDevice(tun, bind, device.NewLogger(device.LogLevelSilent, ""))
+	if err := dev.IpcSet(c.uapi()); err != nil {
+		closeWireGuardDevice(dev)
+		return nil, errors.New("could not configure the WireGuard engine")
+	}
+	if err := dev.Up(); err != nil {
+		closeWireGuardDevice(dev)
+		return nil, errors.New("could not open the WireGuard transport")
+	}
+	listener, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(listenPort)))
+	if err != nil {
+		closeWireGuardDevice(dev)
+		return nil, errors.New("could not bind the local proxy port")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	e := &Engine{
+		config:      c,
+		stack:       stack,
+		device:      dev,
+		listener:    netutil.LimitListener(listener, maxConnections),
+		port:        listener.Addr().(*net.TCPAddr).Port,
+		authDigest:  sha256.Sum256([]byte("Basic " + base64.StdEncoding.EncodeToString([]byte(username+":"+password)))),
+		ctx:         ctx,
+		cancel:      cancel,
+		done:        make(chan struct{}),
+		connections: make(map[net.Conn]struct{}),
+	}
+	e.transport = &http.Transport{
+		Proxy:                 nil, // Never use environment/system proxies.
+		DialContext:           e.dialContext,
+		MaxIdleConns:          32,
+		MaxIdleConnsPerHost:   8,
+		MaxConnsPerHost:       32,
+		IdleConnTimeout:       30 * time.Second,
+		ResponseHeaderTimeout: 30 * time.Second,
+		TLSHandshakeTimeout:   10 * time.Second,
+		ExpectContinueTimeout: time.Second,
+	}
+	e.server = &http.Server{
+		Handler:           http.HandlerFunc(e.serveHTTP),
+		ReadHeaderTimeout: 10 * time.Second,
+		IdleTimeout:       30 * time.Second,
+		MaxHeaderBytes:    32 * 1024,
+		ErrorLog:          log.New(io.Discard, "", 0),
+		BaseContext:       func(net.Listener) context.Context { return e.ctx },
+		ConnState: func(c net.Conn, state http.ConnState) {
+			switch state {
+			case http.StateNew:
+				e.track(c)
+			case http.StateClosed:
+				e.untrack(c)
+			}
+		},
+	}
+	go func() {
+		defer close(e.done)
+		// There is no secret-bearing log output or fallback on Serve failure.
+		_ = e.server.Serve(e.listener)
+	}()
+	return e, nil
+}
+
+func validCredentials(username, password string) bool {
+	if len(username) < 1 || len(username) > 128 || len(password) < 16 || len(password) > 256 || strings.Contains(username, ":") {
+		return false
+	}
+	for _, v := range []string{username, password} {
+		for _, r := range v {
+			if r < 0x21 || r > 0x7e {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Port returns the bound 127.0.0.1 TCP port.
+func (e *Engine) Port() int { return e.port }
+
+func closeWireGuardDevice(dev *device.Device) {
+	// Device.Close closes the TUN before stopping receivers. Drain/remove peers
+	// first so an in-flight netstack write cannot race the TUN's channel close.
+	// Removing them also prevents a delayed TUN-up event from restarting them.
+	dev.RemoveAllPeers()
+	dev.Close()
+}
+
+// Close is idempotent. It cancels pending requests and closes all streams,
+// including CONNECT streams that net/http no longer owns after hijacking.
+func (e *Engine) Close() {
+	e.closeOnce.Do(func() {
+		e.cancel()
+		e.mu.Lock()
+		e.closed = true
+		connections := make([]net.Conn, 0, len(e.connections))
+		for c := range e.connections {
+			connections = append(connections, c)
+		}
+		e.mu.Unlock()
+		_ = e.server.Close()
+		for _, c := range connections {
+			_ = c.Close()
+		}
+		e.transport.CloseIdleConnections()
+		closeWireGuardDevice(e.device) // Owns and closes its userspace TUN exactly once.
+		<-e.done
+	})
+}
+
+func (e *Engine) track(c net.Conn) bool {
+	e.mu.Lock()
+	if e.closed {
+		e.mu.Unlock()
+		_ = c.Close()
+		return false
+	}
+	e.connections[c] = struct{}{}
+	e.mu.Unlock()
+	return true
+}
+
+func (e *Engine) untrack(c net.Conn) {
+	e.mu.Lock()
+	delete(e.connections, c)
+	e.mu.Unlock()
+}
+
+func (e *Engine) dialContext(parent context.Context, network, address string) (net.Conn, error) {
+	if network != "tcp" && network != "tcp4" && network != "tcp6" {
+		return nil, errBadInput
+	}
+	host, portText, err := net.SplitHostPort(address)
+	if err != nil || host == "" || strings.ContainsAny(host, "\x00\r\n\t /\\@") {
+		return nil, errBadInput
+	}
+	port, err := strconv.ParseUint(portText, 10, 16)
+	if err != nil || port == 0 {
+		return nil, errBadInput
+	}
+	ctx, cancel := context.WithTimeout(parent, dialTimeout)
+	defer cancel()
+	stopCancel := context.AfterFunc(e.ctx, cancel)
+	defer stopCancel()
+	if e.ctx.Err() != nil {
+		return nil, errClosed
+	}
+	// This resolver uses ONLY DNS servers in the userspace stack. Never replace
+	// it with net.Lookup*, net.DefaultResolver, or net.Dial(er).
+	addresses, err := e.stack.LookupContextHost(ctx, host)
+	if err != nil {
+		return nil, errors.New("tunneled DNS resolution failed")
+	}
+	var candidates []netip.Addr
+	for _, address := range addresses {
+		addr, err := netip.ParseAddr(address)
+		if err != nil {
+			continue
+		}
+		addr = addr.Unmap()
+		if !e.config.hasFamily(addr) || !e.config.allows(addr) || (network == "tcp4" && !addr.Is4()) || (network == "tcp6" && !addr.Is6()) {
+			continue
+		}
+		candidates = append(candidates, addr)
+	}
+	if len(candidates) == 0 {
+		return nil, errNoRoute
+	}
+	for i, addr := range candidates {
+		if ctx.Err() != nil {
+			break
+		}
+		deadline, _ := ctx.Deadline()
+		budget := time.Until(deadline) / time.Duration(len(candidates)-i)
+		attempt, cancelAttempt := context.WithTimeout(ctx, budget)
+		c, err := e.stack.DialContextTCPAddrPort(attempt, netip.AddrPortFrom(addr, uint16(port)))
+		cancelAttempt()
+		if err != nil {
+			continue
+		}
+		tracked := &trackedConn{idleConn: &idleConn{Conn: c, timeout: idleTimeout}, engine: e}
+		if !e.track(tracked) {
+			return nil, errClosed
+		}
+		return tracked, nil
+	}
+	return nil, errors.New("WireGuard destination connection failed")
+}
+
+// trackedConn applies a sliding idle deadline to bound abandoned streams while
+// allowing active video transfers to last indefinitely.
+type trackedConn struct {
+	*idleConn
+	engine *Engine
+	once   sync.Once
+}
+
+func (c *trackedConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		err = c.Conn.Close()
+		c.engine.untrack(c)
+	})
+	return err
+}
+
+func (c *trackedConn) CloseWrite() error {
+	if half, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return half.CloseWrite()
+	}
+	return c.Close()
+}
+
+func (e *Engine) String() string {
+	return fmt.Sprintf("WireGuard local proxy on 127.0.0.1:%d", e.port)
+}
