diff --git a/scripts/verify-wireguard-bundle.py b/scripts/verify-wireguard-bundle.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f0e33ef631728e2a6953263cb3c46bd155e5198
--- /dev/null
+++ b/scripts/verify-wireguard-bundle.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""Inspect an actually built .mpp; this is not an APK/device connectivity test."""
+import argparse
+import hashlib
+from pathlib import Path
+import re
+import struct
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+import zipfile
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def check_elf(data, abi):
+    require(len(data) >= 64 and data[:6] == b"\x7fELF\x02\x01", f"Invalid ELF64: {abi}")
+    require(struct.unpack_from("<H", data, 16)[0] == 3, f"Not a shared library: {abi}")
+    machine = 183 if abi == "arm64-v8a" else 62
+    require(struct.unpack_from("<H", data, 18)[0] == machine, f"Wrong machine: {abi}")
+    phoff = struct.unpack_from("<Q", data, 32)[0]
+    phsize, count = struct.unpack_from("<HH", data, 54)
+    require(phsize >= 56 and phoff + phsize * count <= len(data), "Invalid ELF headers")
+    loads = 0
+    for index in range(count):
+        offset = phoff + phsize * index
+        kind, flags = struct.unpack_from("<II", data, offset)
+        if kind == 1:
+            loads += 1
+            alignment = struct.unpack_from("<Q", data, offset + 48)[0]
+            require(alignment >= 16384, f"ELF LOAD is not 16 KiB aligned: {abi}")
+        if kind == 0x6474E551:
+            require(not flags & 1, f"Executable ELF stack: {abi}")
+    require(loads > 0, f"No ELF LOAD segments: {abi}")
+
+
+def dex_classes(dexdump, dex_path):
+    # Android's own tool validates DEX structure/checksum and emits its API view.
+    subprocess.run([str(dexdump), "-c", str(dex_path)], check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    result = subprocess.run([str(dexdump), "-l", "xml", str(dex_path)], check=True,
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    start = result.stdout.find(b"<api")
+    require(start >= 0, "dexdump did not return API XML")
+    root = ET.fromstring(result.stdout[start:])
+    classes = {}
+    for package in root.findall("package"):
+        for cls in package.findall("class"):
+            name = package.attrib["name"] + "." + cls.attrib["name"]
+            classes[name] = cls
+    return classes
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("bundle", type=Path)
+    parser.add_argument("--dexdump", required=True, type=Path)
+    args = parser.parse_args()
+    repo = Path(__file__).resolve().parents[1]
+    require(args.bundle.is_file(), "Bundle does not exist")
+    require(args.dexdump.is_file(), "Android SDK dexdump does not exist")
+    with zipfile.ZipFile(args.bundle) as bundle, tempfile.TemporaryDirectory(
+            prefix="wireguard-bundle-check-") as tmp:
+        require(bundle.testzip() is None, "Bundle ZIP CRC check failed")
+        names = bundle.namelist()
+        require(len(names) == len(set(names)), "Duplicate bundle ZIP entries")
+        for abi in ("arm64-v8a", "x86_64"):
+            name = f"wireguard/{abi}/libmorphewireguard.so"
+            data = bundle.read(name)
+            local = repo / "native/wireguard/build/android" / abi / "libmorphewireguard.so"
+            require(data == local.read_bytes(), f"Bundled native library differs: {abi}")
+            check_elf(data, abi)
+            print(f"PASS native {abi}: {len(data)} bytes, SHA256 {hashlib.sha256(data).hexdigest()}")
+
+        for resource in (
+                "wireguard/licenses/MORPHE-NOTICE.txt",
+                "wireguard/licenses/MORPHE-LICENSE.txt",
+                "wireguard/licenses/dependencies/golang.zx2c4.com/wireguard/LICENSE",
+                "wireguard/licenses/dependencies/gvisor.dev/gvisor/LICENSE"):
+            require(len(bundle.read(resource)) > 0, f"Missing notice: {resource}")
+        require(bundle.read("wireguard/licenses/MORPHE-NOTICE.txt") == (repo / "NOTICE").read_bytes(),
+                "Original Morphe NOTICE changed during packaging")
+
+        resources = ET.fromstring(bundle.read("addresources/values/shared-youtube/strings.xml"))
+        resource_names = [item.attrib["name"] for item in resources.findall("string")]
+        required = {"morphe_wireguard_settings_title", "morphe_wireguard_settings_summary"}
+        for source in (repo / "extensions/shared-youtube/library/src/main/java/app/morphe/extension/shared/wireguard").glob("*.java"):
+            required.update(re.findall(r'"(morphe_wireguard_[a-z_]+)"', source.read_text()))
+        require(required <= set(resource_names), "Some WireGuard UI strings are missing from bundle")
+        require(all(resource_names.count(name) == 1 for name in required), "Duplicate WireGuard strings")
+        print(f"PASS UI resources: {len(required)} keys; original and dependency notices present")
+
+        manifest = bundle.read("META-INF/MANIFEST.MF").decode("utf-8").replace("\r\n ", "")
+        require("unofficial" in manifest.lower(), "Bundle is not marked unofficial")
+        patch_classes = [f"app.morphe.patches.{app}.misc.wireguard.WireGuardPatchKt"
+                         for app in ("youtube", "music")]
+        for patch_class in patch_classes:
+            require(patch_class.replace(".", "/") + ".class" in names,
+                    f"Compiled JVM WireGuard patch is missing: {patch_class}")
+        require("app/morphe/patches/shared/misc/wireguard/WireGuardRuntimeKt.class" in names,
+                "Shared WireGuard installation helper is missing")
+        for stale in ("WireGuardNativePayload", "WireGuardIncludedFingerprint"):
+            require(f"app/morphe/patches/youtube/misc/wireguard/{stale}.class" not in names,
+                    f"Stale pre-refactor JVM class remains: {stale}")
+
+        main_classes = {}
+        dex_names = [name for name in names if re.fullmatch(r"classes(?:[2-9]|[1-9][0-9]+)?\.dex", name)]
+        require(dex_names, "No Android patch DEX; buildAndroid has not completed")
+        for index, name in enumerate(dex_names):
+            path = Path(tmp) / f"patch-{index}.dex"
+            path.write_bytes(bundle.read(name))
+            main_classes.update(dex_classes(args.dexdump, path))
+        for patch_class in patch_classes:
+            require(patch_class in main_classes,
+                    f"WireGuard patch is absent from the Android patch DEX: {patch_class}")
+        require("app.morphe.patches.shared.misc.wireguard.WireGuardRuntimeKt" in main_classes,
+                "Shared WireGuard installation helper is absent from Android DEX")
+        for stale in ("WireGuardNativePayload", "WireGuardIncludedFingerprint"):
+            require(f"app.morphe.patches.youtube.misc.wireguard.{stale}" not in main_classes,
+                    f"Stale pre-refactor Android DEX class remains: {stale}")
+
+        extension = Path(tmp) / "shared-youtube.dex"
+        extension.write_bytes(bundle.read("extensions/shared-youtube.mpe"))
+        classes = dex_classes(args.dexdump, extension)
+        package = "app.morphe.extension.shared.wireguard."
+        for name in ("ConfigText", "NativeTunnel", "WireGuardConfigStore", "WireGuardProxy",
+                     "WireGuardPreference", "WireGuardSettingsActivity"):
+            require(package + name in classes, f"Runtime class missing from DEX: {name}")
+        methods = {method.attrib["name"]: method for method in classes[package + "NativeTunnel"].findall("method")}
+        expected = {
+            "start": ("int", ["java.lang.String", "java.lang.String", "java.lang.String", "int"]),
+            "stop": ("void", []),
+            "validate": ("void", ["java.lang.String"]),
+        }
+        for name, (result_type, parameter_types) in expected.items():
+            method = methods[name]
+            require(method.attrib.get("native") == "true" and method.attrib.get("static") == "true",
+                    f"JNI method flags changed: {name}")
+            require(method.attrib.get("return") == result_type, f"JNI return type changed: {name}")
+            require([p.attrib["type"] for p in method.findall("parameter")] == parameter_types,
+                    f"JNI parameters changed: {name}")
+        marker = [m for m in classes[package + "WireGuardProxy"].findall("method")
+                  if m.attrib["name"] == "isPatchIncluded"]
+        require(len(marker) == 1, "Patch-presence injection method was removed or duplicated")
+        music_extension = Path(tmp) / "music.dex"
+        music_extension.write_bytes(bundle.read("extensions/music.mpe"))
+        music_classes = dex_classes(args.dexdump, music_extension)
+        for name in ("settings.Settings", "settings.preference.MusicPreferenceFragment",
+                     "patches.EnableAudioVideoSwitchPatch", "patches.lyrics.derive.OpenAIClient"):
+            require("app.morphe.extension.music." + name in music_classes,
+                    f"Music runtime class missing from DEX: {name}")
+        # DEX string constants may be Modified UTF-8. Keep all bytes intact;
+        # the instruction opcodes and method descriptors checked here are ASCII.
+        disassembly = subprocess.run([str(args.dexdump), "-d", str(music_extension)],
+                                     check=True, stdout=subprocess.PIPE,
+                                     stderr=subprocess.PIPE).stdout
+        direct_url_calls = re.findall(br"invoke-\S+[^\n]*Ljava/net/URL;\.(?:openConnection|openStream):",
+                                      disassembly)
+        require(not direct_url_calls, "Music extension still contains direct URL connection/stream calls")
+        routed_calls = re.findall(
+            br"invoke-static(?:/range)?[^\n]*Lapp/morphe/extension/shared/requests/Requester;\.openConnection:",
+            disassembly)
+        require(len(routed_calls) >= 16, "Music Requester routing calls are unexpectedly missing")
+        print(f"PASS Music DEX routing: {len(routed_calls)} Requester calls, no direct URL connection/stream calls")
+        print("PASS both app patch DEX classes, shared/Music extension DEX and three exact JNI signatures")
+    print("PASS bundle inspection; APK application and device connectivity NOT tested")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/wireguard-bundle/WireGuardBundleSmoke.java b/tests/wireguard-bundle/WireGuardBundleSmoke.java
new file mode 100644
index 0000000000000000000000000000000000000000..9084106aef12b9fbff897b2764365fa2640758a3
--- /dev/null
+++ b/tests/wireguard-bundle/WireGuardBundleSmoke.java
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import app.morphe.patcher.patch.Patch;
+import app.morphe.patcher.patch.PatchLoader;
+import app.morphe.patcher.patch.Compatibility;
+
+import java.io.File;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/** Loads the built archive through the real Morphe loader without a target APK. */
+public final class WireGuardBundleSmoke {
+    public static void main(String[] args) {
+        if (args.length != 1) throw new IllegalArgumentException("Pass one built .mpp file");
+        File bundle = new File(args[0]);
+        if (!bundle.isFile()) throw new IllegalArgumentException("Bundle does not exist");
+        Set<Patch> patches = new PatchLoader.Jar(Set.of(bundle));
+        Map<String, Patch> wireGuardByPackage = new HashMap<>();
+        for (Patch patch : patches) {
+            if ("WireGuard proxy (experimental)".equals(patch.getName())) {
+                if (!patch.getDefault()) throw new AssertionError("WireGuard patch must be default-selected");
+                if (patch.getCompatibility() == null || patch.getCompatibility().size() != 1) {
+                    throw new AssertionError("Each WireGuard patch must target exactly one app");
+                }
+                String packageName = patch.getCompatibility().get(0).getPackageName();
+                if (wireGuardByPackage.put(packageName, patch) != null) {
+                    throw new AssertionError("Duplicate WireGuard patch for " + packageName);
+                }
+            }
+        }
+        Set<String> expectedPackages = Set.of("com.google.android.youtube",
+                "com.google.android.apps.youtube.music");
+        if (!wireGuardByPackage.keySet().equals(expectedPackages)) {
+            throw new AssertionError("Wrong WireGuard targets: " + wireGuardByPackage.keySet());
+        }
+        for (Map.Entry<String, Patch> entry : wireGuardByPackage.entrySet()) {
+            int networkDependencies = 0;
+            for (Patch dependency : entry.getValue().getDependencies()) {
+                if (!"Network proxy".equals(dependency.getName())) continue;
+                networkDependencies++;
+                if (dependency.getCompatibility() == null || dependency.getCompatibility().size() != 1
+                        || !entry.getKey().equals(dependency.getCompatibility().get(0).getPackageName())) {
+                    throw new AssertionError("Cross-app Network proxy dependency: " + entry.getKey());
+                }
+            }
+            if (networkDependencies != 1) {
+                throw new AssertionError("Expected one app-specific Network proxy dependency: " + entry.getKey());
+            }
+        }
+        Compatibility music = wireGuardByPackage.get("com.google.android.apps.youtube.music")
+                .getCompatibility().get(0);
+        Set<String> musicVersions = new HashSet<>();
+        music.getTargets().forEach(target -> musicVersions.add(target.getVersion()));
+        if (!musicVersions.equals(Set.of("9.15.51", "9.20.53", "9.30.53", "9.42.52", "9.43.51", "9.44.52"))) {
+            throw new AssertionError("Unexpected Music compatibility targets: " + musicVersions);
+        }
+        System.out.println("PASS real Morphe JAR loader: " + patches.size() + " patches discovered");
+        System.out.println("PASS two default-selected WireGuard patches, one per app, with matching Network proxy dependencies");
+        System.out.println("PASS Music declares its own six compatibility targets, not YouTube versions");
+        System.out.println("APK application and Android DEX loading were NOT executed by this JVM check");
+    }
+}
diff --git a/tests/wireguard-jni/WireGuardJniSmoke.java b/tests/wireguard-jni/WireGuardJniSmoke.java
new file mode 100644
index 0000000000000000000000000000000000000000..cd1aa8adbef6590750f40db42860c6be37eb4800
--- /dev/null
+++ b/tests/wireguard-jni/WireGuardJniSmoke.java
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import app.morphe.extension.shared.wireguard.NativeTunnel;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+/** Host JNI checks. These do not substitute for Android/ART or real-server testing. */
+public final class WireGuardJniSmoke {
+    private static int checks;
+    private static final String USER = "jni-test";
+    private static final String PASSWORD = "test-only-proxy-password-not-a-vpn-secret";
+
+    private static String key(int offset) {
+        byte[] bytes = new byte[32];
+        for (int i = 0; i < bytes.length; i++) bytes[i] = (byte) (offset + i);
+        return Base64.getEncoder().encodeToString(bytes);
+    }
+
+    private static String config() {
+        // Deterministic test-only keys; the peer does not exist and no successful handshake is expected.
+        return "# UTF-8 comment: 한글 🦊\n[Interface]\nPrivateKey = " + key(1)
+                + "\nAddress = 10.77.0.2/32\nDNS = 10.77.0.1\n[Peer]\nPublicKey = " + key(33)
+                + "\nAllowedIPs = 10.77.0.0/24\nEndpoint = 127.0.0.1:51820\n";
+    }
+
+    private static void check(boolean condition, String label) {
+        if (!condition) throw new AssertionError(label);
+        checks++;
+    }
+
+    private static void rejects(Class<? extends Throwable> type, Runnable action) {
+        try {
+            action.run();
+        } catch (Throwable error) {
+            check(type.isInstance(error), "Wrong exception type: " + error.getClass().getName());
+            check(error.getMessage() == null || (!error.getMessage().contains(key(1))
+                    && !error.getMessage().contains("secret-hook-marker")), "Error leaked profile values");
+            return;
+        }
+        throw new AssertionError("Expected " + type.getName());
+    }
+
+    private static String request(int port, String auth) throws Exception {
+        try (Socket socket = new Socket()) {
+            socket.connect(new InetSocketAddress("127.0.0.1", port), 1000);
+            socket.setSoTimeout(3000);
+            OutputStream output = socket.getOutputStream();
+            String headers = "CONNECT 203.0.113.7:443 HTTP/1.1\r\nHost: 203.0.113.7:443\r\n"
+                    + (auth == null ? "" : "Proxy-Authorization: Basic " + auth + "\r\n")
+                    + "Connection: close\r\n\r\n";
+            output.write(headers.getBytes(StandardCharsets.US_ASCII));
+            output.flush();
+            return new BufferedReader(new InputStreamReader(socket.getInputStream(),
+                    StandardCharsets.US_ASCII)).readLine();
+        }
+    }
+
+    public static void main(String[] args) throws Exception {
+        NativeTunnel.validate(config());
+        checks++;
+        NativeTunnel.validate("\ufeff" + config());
+        checks++;
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate(null));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate(""));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate("x".repeat(65537)));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate(config() + "\u0000"));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate(config() + "# \ud800\n"));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate(
+                config().replace("[Peer]", "PostUp = secret-hook-marker\n[Peer]")));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.validate(
+                config().replace("127.0.0.1:51820", "example.test:51820")));
+        rejects(IllegalArgumentException.class, () -> NativeTunnel.start(config(), USER, PASSWORD, -1));
+        NativeTunnel.stop();
+        NativeTunnel.stop();
+        checks++;
+        System.out.println("JNI validation and idle-stop checks passed: " + checks);
+        if (args.length == 1 && args[0].equals("--validate-only")) {
+            System.out.println("Network/lifecycle checks NOT EXECUTED (--validate-only).");
+            return;
+        }
+
+        int port = NativeTunnel.start(config(), USER, PASSWORD, 0);
+        try {
+            check(port > 0 && port <= 65535, "Invalid bound port");
+            rejects(IllegalStateException.class, () -> NativeTunnel.start(config(), USER, PASSWORD, 0));
+            check(request(port, null).startsWith("HTTP/1.1 407"), "Unauthenticated client was not rejected");
+            String wrong = Base64.getEncoder().encodeToString((USER + ":wrong-password")
+                    .getBytes(StandardCharsets.US_ASCII));
+            check(request(port, wrong).startsWith("HTTP/1.1 407"), "Wrong authentication was not rejected");
+            String auth = Base64.getEncoder().encodeToString((USER + ":" + PASSWORD)
+                    .getBytes(StandardCharsets.US_ASCII));
+            // Outside AllowedIPs: failure must be immediate, with no system dial fallback.
+            check(request(port, auth).startsWith("HTTP/1.1 502"), "Out-of-route connection was not blocked");
+        } finally {
+            NativeTunnel.stop();
+        }
+        try (Socket socket = new Socket()) {
+            try {
+                socket.connect(new InetSocketAddress("127.0.0.1", port), 1000);
+                throw new AssertionError("Proxy still listening after stop");
+            } catch (java.io.IOException expected) {
+                checks++;
+            }
+        }
+        for (int i = 0; i < 5; i++) {
+            check(NativeTunnel.start(config(), USER, PASSWORD, 0) > 0, "Restart failed");
+            NativeTunnel.stop();
+        }
+        System.out.println("All host JNI checks passed: " + checks);
+    }
+}
diff --git a/scripts/set-wireguard-defaults.py b/scripts/set-wireguard-defaults.py
new file mode 100755
index 0000000000000000000000000000000000000000..37728644d41d1121c942cb52b42a5d8286a2d6ba
--- /dev/null
+++ b/scripts/set-wireguard-defaults.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+"""Repair the Android default flags in the published v2.1.1 WireGuard bundle.
+
+The input is pinned by SHA-256. Only two DEX instructions, the DEX header
+hashes, and the bundle manifest version/timestamp may change. This is an
+artifact repair, not a Gradle rebuild. The JVM flags are already correct.
+Requires a JDK (javap) and Android SDK Build-Tools (dexdump).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+from pathlib import Path
+import re
+import struct
+import subprocess
+import tempfile
+import zipfile
+import zlib
+
+
+INPUT_SHA256 = "9905a6a9a57d281532c94a9b53215a5414ccc4185b880031c0f67d0361fd69ca"
+VERSION = "2.1.2"
+APPS = ("music", "youtube")
+MANIFEST = "META-INF/MANIFEST.MF"
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise ValueError(message)
+
+
+def dex_defaults(disassembly: str) -> dict[str, tuple[int, bool]]:
+    """Read the Boolean argument passed to PatchKt.patch in each initializer."""
+    found = {}
+    for block in re.split(r"(?m)^Class #", disassembly):
+        descriptor = re.search(r"Class descriptor\s+: '([^']+)'", block)
+        if descriptor is None:
+            continue
+        for app in APPS:
+            expected = f"Lapp/morphe/patches/{app}/misc/wireguard/WireGuardPatchKt;"
+            if descriptor[1] != expected:
+                continue
+            require(app not in found, f"Duplicate Android patch: {app}")
+            initializer = re.search(
+                r"name\s+: '<clinit>'(.*?)(?=\n    #|\Z)", block, re.DOTALL)
+            require(initializer is not None, f"Missing Android initializer: {app}")
+            # Guard the actual Boolean argument and the immediately following
+            # constructor call, rather than matching unrelated true constants.
+            sites = re.findall(
+                r"(?m)^([0-9a-f]+):[^\n]*\|0009: const/4 v3, #int ([01]) //[^\n]*\n"
+                r"[0-9a-f]+:[^\n]*\|000a: invoke-static \{v1, v2, v3, v0\}, "
+                r"Lapp/morphe/patcher/patch/PatchKt;\.patch:"
+                r"\(Ljava/lang/String;Ljava/lang/String;ZLkotlin/jvm/functions/Function1;\)",
+                initializer[1])
+            require(len(sites) == 1, f"Unexpected Android initializer: {app}")
+            offset, value = sites[0]
+            found[app] = (int(offset, 16), value == "1")
+    require(set(found) == set(APPS), "Both Android WireGuard patches must be present")
+    return found
+
+
+def inspect(bundle: Path, dexdump: Path, android_default: bool = True
+            ) -> dict[str, tuple[int, bool]]:
+    with zipfile.ZipFile(bundle) as archive, tempfile.TemporaryDirectory() as tmp:
+        require(archive.testzip() is None, "ZIP CRC check failed")
+        require(len(archive.namelist()) == len(set(archive.namelist())), "Duplicate ZIP entries")
+        dex = archive.read("classes.dex")
+        require(dex[:8] == b"dex\n038\x00", "Unexpected DEX version")
+        require(dex[12:32] == hashlib.sha1(dex[32:]).digest(), "DEX SHA-1 mismatch")
+        require(struct.unpack_from("<I", dex, 8)[0] == zlib.adler32(dex[12:]),
+                "DEX Adler32 mismatch")
+        dex_path = Path(tmp) / "classes.dex"
+        dex_path.write_bytes(dex)
+        subprocess.run([str(dexdump), "-c", str(dex_path)], check=True,
+                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        disassembly = subprocess.run(
+            [str(dexdump), "-d", str(dex_path)], check=True,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout.decode(errors="replace")
+        defaults = dex_defaults(disassembly)
+        for app in APPS:
+            patch_class = f"app.morphe.patches.{app}.misc.wireguard.WireGuardPatchKt"
+            javap = subprocess.run(
+                ["javap", "-classpath", str(bundle.resolve()), "-c", "-p", patch_class],
+                check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout.decode()
+            initializer = javap.split("static {};", 1)
+            require(len(initializer) == 2, f"Missing JVM initializer: {app}")
+            require(re.search(
+                r"4: iconst_1\s+5: invokedynamic[^\n]*\n\s*10: invokestatic[^\n]*"
+                r"app/morphe/patcher/patch/PatchKt.patch:", initializer[1]) is not None,
+                f"JVM patch must be selected by default: {app}")
+            require(defaults[app][1] == android_default,
+                    f"Android {app} default={defaults[app][1]}, expected {android_default}")
+            print(f"PASS {app}: JVM default=True; Android default={android_default}")
+        return defaults
+
+
+def repair(original: Path, output: Path, dexdump: Path, timestamp_ms: int) -> None:
+    require(hashlib.sha256(original.read_bytes()).hexdigest() == INPUT_SHA256,
+            "Input must be the exact published v2.1.1 bundle; refusing unrecognized input")
+    require(not output.exists(), "Output already exists; choose a new path")
+    require(original.resolve() != output.resolve(), "Input and output must differ")
+    require(timestamp_ms > 0, "Timestamp must be positive")
+    defaults = inspect(original, dexdump, android_default=False)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="wireguard-repair-", dir=output.parent) as tmp:
+        candidate = Path(tmp) / "repaired.mpp"
+        with zipfile.ZipFile(original) as src, zipfile.ZipFile(candidate, "w") as dst:
+            dst.comment = src.comment
+            for info in src.infolist():
+                payload = src.read(info)
+                if info.filename == "classes.dex":
+                    dex = bytearray(payload)
+                    for offset, _ in defaults.values():
+                        require(dex[offset:offset + 2] == b"\x12\x03", "Unexpected DEX opcode")
+                        dex[offset + 1] = 0x13  # const/4 v3, #int 1
+                    changed = {i for i, (a, b) in enumerate(zip(payload, dex)) if a != b}
+                    require(changed == {offset + 1 for offset, _ in defaults.values()},
+                            "Unexpected DEX instruction change")
+                    dex[12:32] = hashlib.sha1(dex[32:]).digest()
+                    struct.pack_into("<I", dex, 8, zlib.adler32(dex[12:]))
+                    payload = bytes(dex)
+                elif info.filename == MANIFEST:
+                    require(payload.count(b"Version: 2.1.1\r\n") == 1, "Unexpected bundle version")
+                    payload = payload.replace(b"Version: 2.1.1\r\n",
+                                              f"Version: {VERSION}\r\n".encode())
+                    payload, count = re.subn(
+                        rb"(?m)^Timestamp: [0-9]+\r$",
+                        f"Timestamp: {timestamp_ms}\r".encode(), payload)
+                    require(count == 1, "Unexpected manifest timestamp")
+                dst.writestr(info, payload)
+        inspect(candidate, dexdump)
+        with zipfile.ZipFile(original) as src, zipfile.ZipFile(candidate) as dst:
+            require(src.namelist() == dst.namelist(), "Archive members/order changed")
+            changed = {name for name in src.namelist() if src.read(name) != dst.read(name)}
+            require(changed == {"classes.dex", MANIFEST}, "Unexpected bundle payload change")
+        candidate.rename(output)
+    print("PASS only two DEX Boolean literals, DEX hashes and manifest changed")
+    print(f"SHA-256 {hashlib.sha256(output.read_bytes()).hexdigest()}  {output}")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    verify = commands.add_parser("verify", help="Require both JVM and Android defaults to be true")
+    verify.add_argument("bundle", type=Path)
+    verify.add_argument("--dexdump", type=Path, required=True)
+    transform = commands.add_parser("repair", help="Create v2.1.2 from the pinned v2.1.1 bundle")
+    transform.add_argument("original", type=Path)
+    transform.add_argument("output", type=Path)
+    transform.add_argument("--dexdump", type=Path, required=True)
+    transform.add_argument("--timestamp-ms", type=int, required=True)
+    args = parser.parse_args()
+    if args.command == "verify":
+        inspect(args.bundle, args.dexdump)
+    else:
+        repair(args.original, args.output, args.dexdump, args.timestamp_ms)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/docs/wireguard-default-verification.md b/docs/wireguard-default-verification.md
new file mode 100644
index 0000000000000000000000000000000000000000..09f227b0be961053a4ac019445e987905900691a
--- /dev/null
+++ b/docs/wireguard-default-verification.md
@@ -0,0 +1,81 @@
+# v2.1.2 Android default-selection correction
+
+v2.1.2 (2026-11-08) corrects default patch selection in the Android bundle.
+It is a standard release, not a pre-release.
+
+## Cause
+
+The published v2.1.1 bundle has `default=true` in both JVM `WireGuardPatchKt.class`
+initializers and in `patches-list.json`. Its Android `classes.dex` still passes
+`false` to `PatchKt.patch` for both apps. The previous updater changed only the
+JVM classes and manifest. Morphe Manager
+[loads Android patches from DEX](https://github.com/MorpheApp/morphe-manager/blob/main/app/src/main/java/app/morphe/manager/patcher/patch/PatchBundle.kt),
+so the JVM-only check missed the setting actually used on Android.
+
+## Correction and verification
+
+`scripts/set-wireguard-defaults.py` now accepts only the exact released v2.1.1
+bundle, SHA-256
+`9905a6a9a57d281532c94a9b53215a5414ccc4185b880031c0f67d0361fd69ca`.
+It identifies each initializer's Boolean argument using Android SDK `dexdump`,
+changes `const/4 v3, 0` to `const/4 v3, 1`, and updates DEX SHA-1 and Adler32.
+The manifest version becomes `2.1.2`.
+
+The release bundle passed these checks:
+
+- Both JVM initializers pass `true`, checked with JDK `javap`.
+- Both Android initializers pass `true` to `PatchKt.patch`, checked with SDK
+  `dexdump`; the published v2.1.1 fails this same default-selection check.
+- DEX SHA-1, Adler32, SDK checksum verification and ZIP CRC checks pass.
+- DEX instruction changes are exactly Music byte `0x098aa3` and YouTube byte
+  `0x13a90b`, both `03 → 13`. All other DEX changes are header hashes.
+- Only `classes.dex` and `META-INF/MANIFEST.MF` differ between the bundles.
+  JVM classes, native libraries, extension DEX, resources, dependency payloads
+  and archive member names/order are unchanged.
+- The review patch and corresponding source use `default=true` for both apps,
+  with matching Kotlin metadata assertions and JVM loader assertions.
+
+Bundle SHA-256:
+`179132ea77ee7ce8f5afc3c595f0aff2edf9ff19362ba4d40e3396c4cbe0864f`.
+
+This is a narrowly scoped artifact repair, not a full Gradle rebuild or an
+Android runtime test. No new APK application, playback, handshake or leak test
+was run. The maintainer's successful v2.1.1 device use remains the existing
+functional evidence; it did not verify default patch selection.
+
+## Reproduce
+
+With Python 3, a JDK providing `javap`, Android SDK Build-Tools 36.0.0, and the
+published v2.1.1 bundle downloaded as `published-v2.1.1.mpp`:
+
+```sh
+python3 scripts/set-wireguard-defaults.py repair \
+  published-v2.1.1.mpp morphe-wireguard-youtube-music-preview-2.1.2.mpp \
+  --dexdump "$ANDROID_SDK_ROOT/build-tools/36.0.0/dexdump" \
+  --timestamp-ms 1794114000000
+
+python3 scripts/set-wireguard-defaults.py verify \
+  morphe-wireguard-youtube-music-preview-2.1.2.mpp \
+  --dexdump "$ANDROID_SDK_ROOT/build-tools/36.0.0/dexdump"
+```
+
+The updater refuses unknown input hashes and existing output paths. Run the
+`verify` command after future full builds as well; source/JVM assertions alone
+do not establish the Android default.
+
+## Updating Morphe
+
+The standard v2.1.2 release includes the bundle, corresponding source and
+SHA-256 checksums. The repository's `patches-bundle.json` and `patches-list.json`
+select v2.1.2 after the release assets are available. The custom source reads
+`main/patches-bundle.json`; a GitHub release alone does not change the source's
+download URL or version.
+[Source update implementation](https://github.com/MorpheApp/morphe-manager/blob/main/app/src/main/java/app/morphe/manager/domain/bundles/RemotePatchBundle.kt).
+
+After the source update, normal mode includes each app's WireGuard patch by
+default. Expert mode preserves previously saved selections; choose
+**Selections → Recommended patches** (**선택 항목 → 추천 패치**) once if needed.
+[Selection implementation](https://github.com/MorpheApp/morphe-manager/blob/main/app/src/main/java/app/morphe/manager/ui/viewmodel/PatchFlow.kt).
+
+Patch inclusion does not enable traffic tunneling. `WIREGUARD_ENABLED` remains
+`false` until a profile is imported and the in-app switch is enabled.
