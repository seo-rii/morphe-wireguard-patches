@@ -0,0 +1,125 @@
+# App-local WireGuard transport
+
+This native component is a small HTTP proxy over the official `wireguard-go`
+implementation and its gVisor-backed userspace network stack. It does not use
+`VpnService`, an OS TUN device, root, system routing changes, `wg-quick`, a shell,
+or a separately installed VPN application. It is not a Proton product.
+
+## Public JNI contract
+
+Java class: `app.morphe.extension.shared.wireguard.NativeTunnel`.
+
+```java
+public static native int start(String config, String username, String password, int listenPort);
+public static native void stop();
+public static native void validate(String config);
+```
+
+- `validate` throws a sanitized `IllegalArgumentException` on invalid input.
+- `start` binds **only** `127.0.0.1`, returns its port, and does not wait for a
+  handshake. Zero requests an ephemeral port. A positive result means *ready*,
+  not *connected*. Bind/initialization failures throw `IllegalStateException`.
+- `stop` is idempotent and closes existing HTTP/CONNECT streams. One native
+  instance is allowed per process; multiple Android processes must not be
+  mistaken for one shared singleton.
+- Generate fresh random credentials for each process. Credentials are mandatory
+  because loopback TCP sockets are accessible to other Android apps. Passwords
+  must contain 16–256 printable non-space ASCII characters; usernames 1–128,
+  excluding `:`. Neither keys nor credentials are logged.
+
+The Java loader must load the packaged `libmorphewireguard.so`. Keep the JNI
+class/method names from obfuscation. `cmd/jni` builds with `GOOS=android` (or
+`-tags jni` for a host-JVM smoke test) and `-buildmode=c-shared`.
+
+## Supported configuration subset (v1)
+
+Exactly one `[Interface]` and one `[Peer]` are accepted. Core fields:
+
+- Interface: `PrivateKey`, `Address`, `DNS`, optional `MTU`, `ListenPort`.
+- Peer: `PublicKey`, `Endpoint`, `AllowedIPs`, optional `PresharedKey`,
+  `PersistentKeepalive`.
+- Endpoint **must be numeric IPv4 or bracketed IPv6**, with a nonzero UDP port.
+  Hostnames are deliberately rejected so startup cannot block on DNS or leak an
+  endpoint-name lookup. Proton's numeric-endpoint exports fit this subset.
+- DNS must contain numeric IPs, be covered by `AllowedIPs`, and have a matching
+  configured interface address family. DNS search domains are unsupported.
+- `AllowedIPs` is honored, including restricted routes. An out-of-route resolved
+  destination fails; it is never sent directly or silently granted a default
+  route. Destination DNS is resolved inside the WireGuard network stack.
+- `PreUp`, `PostUp`, `PreDown`, `PostDown`, `Table`, `FwMark`, `SaveConfig`,
+  Amnezia extensions, and every unknown directive are rejected, never executed
+  or silently ignored. A 64 KiB file and 4 KiB per-line limit are enforced.
+
+IPv4 and IPv6 inside the tunnel are supported when configured. The proxy speaks
+ordinary absolute-form HTTP and TCP `CONNECT`, not SOCKS, QUIC, CONNECT-UDP, or
+MASQUE. YouTube QUIC must be disabled by the integration. HTTPS remains
+end-to-end; the engine neither inspects TLS nor changes certificate validation.
+
+## Failure and lifecycle policy
+
+The engine has no direct dial fallback. Proxy authentication is checked before
+request-triggered destination DNS or outbound application connections. Configured
+WireGuard keepalives/handshakes may occur independently of a proxy request.
+HTTP hop-by-hop/proxy headers are stripped from
+forwarded HTTP requests. There are bounded header/connection counts, dial
+deadlines, and idle stream timeouts. Active streams are tracked and closed on
+stop, including streams hijacked by HTTP `CONNECT`.
+
+This protects only requests routed into the proxy. It cannot block an unpatched
+YouTube networking path, another process, or another application. Android
+background execution and Wi-Fi/cellular transitions need device testing. An
+existing system VPN may carry the outer WireGuard UDP connection (double
+tunneling); this component does not bypass system VPN policies.
+
+## Build and tests
+
+```sh
+go test ./...
+go test -race ./...
+# Separately labeled in-memory protocol tests (not a substitute for UDP tests):
+go test -race -run '^(TestMemory|TestIdle|TestValidate|TestAllowedIPs|FuzzValidate)' ./...
+go test -run '^$' -fuzz FuzzValidate -fuzztime=10s
+GOOS=android GOARCH=arm64 CGO_ENABLED=1 \
+  CC="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android26-clang" \
+  go build -trimpath -buildmode=c-shared -o libmorphewireguard.so ./cmd/jni
+```
+
+The original end-to-end tests create **two actual WireGuard peers** on local UDP sockets,
+with HTTP, verified TLS, and DNS servers inside a second in-memory network stack.
+They test encrypted traffic, a large stream, authentication, routing restrictions,
+no host-network fallback, pipelined CONNECT bytes, and repeated/concurrent
+lifecycle operations. Test credentials are generated locally and are never
+saved. Tests do not contact Proton, YouTube, or any public VPN endpoint.
+
+`TestMemory*` exercises the same two encrypted WireGuard peers and proxy paths
+using upstream `conn/bindtest.ChannelBind` for outer packets instead of UDP. The
+proxy still uses a real loopback TCP listener, while DNS/HTTP/TLS run in the
+userspace stack. This separate suite is useful in restricted build containers,
+but does not verify Android UDP sockets, cellular/Wi-Fi behavior, or a provider.
+Production always uses the official default UDP bind; no alternative transport
+or permission fallback is selected at runtime.
+
+Some Linux build containers forbid the default upstream transport's
+`socket(AF_NETLINK, SOCK_RAW, NETLINK_ROUTE)` route monitor. In this delivery
+environment, `go run ./cmd/diagnose-linux` confirmed that ordinary upstream UDP
+binding succeeds but that netlink operation is denied with `EPERM`. The full
+UDP integration suite therefore fails here and has not been silently skipped.
+Upstream Android builds set `StdNetSupportsStickySockets=false`, so they do not
+open that Linux-only route-monitor socket. Actual Android operation still needs
+a device test; successful in-memory tests and cross-compilation do not prove it.
+
+The commands above document how to run the tests; consult the root verification
+report for which commands were actually executed in the delivery environment.
+
+## Dependencies and licenses
+
+This new component is GPL-3.0-only, matching the surrounding patch project.
+WireGuard cryptography is supplied by upstream, not reimplemented here:
+
+- `golang.zx2c4.com/wireguard` is pinned in `go.mod` and `go.sum` (MIT).
+- Its userspace TCP/IP stack is `gvisor.dev/gvisor` (Apache-2.0).
+- Transitive Go dependencies and their exact checksums are in `go.sum`.
+
+Distributions must preserve the surrounding repository's LICENSE/NOTICE and the
+corresponding dependency notices. Building this library does not authorize
+redistribution of proprietary YouTube APKs.
diff --git a/native/wireguard/cmd/diagnose-linux/main.go b/native/wireguard/cmd/diagnose-linux/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..897a8ac1e4d617216f19862b48656da8fb5ec8f4
--- /dev/null
+++ b/native/wireguard/cmd/diagnose-linux/main.go
@@ -0,0 +1,38 @@
+//go:build linux && !android
+
+// SPDX-License-Identifier: GPL-3.0-only
+
+// diagnose-linux only reports the operation that prevents upstream's default
+// Linux transport from starting. It does not request privileges, retry using a
+// different socket, or modify policy. Android disables this route listener.
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/unix"
+	"golang.zx2c4.com/wireguard/conn"
+)
+
+func main() {
+	bind := conn.NewDefaultBind()
+	_, _, err := bind.Open(0)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "upstream UDP Bind.Open: %v\n", err)
+		os.Exit(1)
+	}
+	_ = bind.Close()
+	fmt.Println("upstream UDP Bind.Open: success")
+	fd, err := unix.Socket(unix.AF_NETLINK, unix.SOCK_RAW|unix.SOCK_CLOEXEC, unix.NETLINK_ROUTE)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Linux route-monitor socket(AF_NETLINK, SOCK_RAW, NETLINK_ROUTE): %v\n", err)
+		os.Exit(1)
+	}
+	defer unix.Close(fd)
+	if err := unix.Bind(fd, &unix.SockaddrNetlink{Family: unix.AF_NETLINK, Groups: unix.RTMGRP_IPV4_ROUTE}); err != nil {
+		fmt.Fprintf(os.Stderr, "Linux route-monitor bind(RTMGRP_IPV4_ROUTE): %v\n", err)
+		os.Exit(1)
+	}
+	fmt.Println("Linux route-monitor creation: success")
+}
diff --git a/native/wireguard/cmd/jni/jni.c b/native/wireguard/cmd/jni/jni.c
new file mode 100644
index 0000000000000000000000000000000000000000..9b8f86f791103d132987a8bef2335cbf2d5f7330
--- /dev/null
+++ b/native/wireguard/cmd/jni/jni.c
@@ -0,0 +1,134 @@
+//go:build android || jni
+
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include <jni.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "_cgo_export.h"
+
+static void throw_error(JNIEnv *env, const char *type, const char *message) {
+    if ((*env)->ExceptionCheck(env)) return;
+    jclass exception = (*env)->FindClass(env, type);
+    if (exception != NULL) {
+        (*env)->ThrowNew(env, exception, message);
+        (*env)->DeleteLocalRef(env, exception);
+    }
+}
+
+static void free_text(char *text) {
+    if (text == NULL) return;
+    size_t length = strlen(text);
+    volatile char *bytes = (volatile char *) text;
+    while (length != 0) bytes[--length] = 0;
+    free(text);
+}
+
+// JNI's GetStringUTFChars uses modified UTF-8, including CESU-8 surrogate
+// pairs. Decode UTF-16 explicitly so valid non-BMP profile comments round-trip
+// as ordinary UTF-8. Reject embedded NUL and unpaired surrogates, never truncate.
+static char *read_utf8(JNIEnv *env, jstring value, size_t max_bytes) {
+    if (value == NULL || (size_t) (*env)->GetStringLength(env, value) > max_bytes) {
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid or oversized WireGuard input.");
+        return NULL;
+    }
+    jsize length = (*env)->GetStringLength(env, value);
+    const jchar *chars = (*env)->GetStringChars(env, value, NULL);
+    if (chars == NULL) return NULL;
+    char *result = (char *) malloc(max_bytes + 1);
+    if (result == NULL) {
+        (*env)->ReleaseStringChars(env, value, chars);
+        throw_error(env, "java/lang/OutOfMemoryError", "Could not allocate WireGuard input.");
+        return NULL;
+    }
+    size_t offset = 0;
+    int valid = 1;
+    for (jsize i = 0; i < length; ++i) {
+        uint32_t code = chars[i];
+        if (code >= 0xd800 && code <= 0xdbff) {
+            if (++i >= length || chars[i] < 0xdc00 || chars[i] > 0xdfff) {
+                valid = 0;
+                break;
+            }
+            code = 0x10000 + ((code - 0xd800) << 10) + (chars[i] - 0xdc00);
+        } else if (code == 0 || (code >= 0xdc00 && code <= 0xdfff)) {
+            valid = 0;
+            break;
+        }
+        size_t count = code < 0x80 ? 1 : code < 0x800 ? 2 : code < 0x10000 ? 3 : 4;
+        if (offset + count > max_bytes) {
+            valid = 0;
+            break;
+        }
+        if (count == 1) {
+            result[offset++] = (char) code;
+        } else {
+            const unsigned char prefix[] = {0, 0, 0xc0, 0xe0, 0xf0};
+            result[offset++] = (char) (prefix[count] | (code >> (6 * (count - 1))));
+            for (size_t remaining = count - 1; remaining != 0; --remaining) {
+                result[offset++] = (char) (0x80 | ((code >> (6 * (remaining - 1))) & 0x3f));
+            }
+        }
+    }
+    result[offset] = '\0';
+    (*env)->ReleaseStringChars(env, value, chars);
+    if (!valid) {
+        free_text(result);
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid or oversized WireGuard input.");
+        return NULL;
+    }
+    return result;
+}
+
+JNIEXPORT jint JNICALL Java_app_morphe_extension_shared_wireguard_NativeTunnel_start(
+        JNIEnv *env, jclass klass, jstring config, jstring username, jstring password, jint port) {
+    (void) klass;
+    if (port < 0 || port > 65535) {
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid local proxy port.");
+        return -1;
+    }
+    char *conf = read_utf8(env, config, 65536);
+    if (conf == NULL) return -1;
+    char *user = read_utf8(env, username, 128);
+    if (user == NULL) {
+        free_text(conf);
+        return -1;
+    }
+    char *pass = read_utf8(env, password, 256);
+    if (pass == NULL) {
+        free_text(user);
+        free_text(conf);
+        return -1;
+    }
+    int result = morphe_wg_start(conf, user, pass, (int)port);
+    free_text(pass);
+    free_text(user);
+    free_text(conf);
+    if (result == -1) {
+        throw_error(env, "java/lang/IllegalArgumentException", "Invalid or unsupported WireGuard configuration.");
+    } else if (result == -2) {
+        throw_error(env, "java/lang/IllegalStateException", "WireGuard proxy is already running.");
+    } else if (result <= 0) {
+        throw_error(env, "java/lang/IllegalStateException", "Could not start the local WireGuard proxy.");
+    }
+    return (jint) result;
+}
+
+JNIEXPORT void JNICALL Java_app_morphe_extension_shared_wireguard_NativeTunnel_stop(JNIEnv *env, jclass klass) {
+    (void) env;
+    (void) klass;
+    morphe_wg_stop();
+}
+
+JNIEXPORT void JNICALL Java_app_morphe_extension_shared_wireguard_NativeTunnel_validate(JNIEnv *env, jclass klass, jstring config) {
+    (void) klass;
+    char *conf = read_utf8(env, config, 65536);
+    if (conf == NULL) return;
+    char *error = morphe_wg_validate(conf);
+    free_text(conf);
+    if (error != NULL) {
+        throw_error(env, "java/lang/IllegalArgumentException", error);
+        free(error);
+    }
+}
diff --git a/native/wireguard/cmd/jni/main.go b/native/wireguard/cmd/jni/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..a9ecff582fd64ff32815e78a129d3dc83abd153b
--- /dev/null
+++ b/native/wireguard/cmd/jni/main.go
@@ -0,0 +1,70 @@
+//go:build android || jni
+
+// SPDX-License-Identifier: GPL-3.0-only
+
+// This package is built with -buildmode=c-shared. The C shim exposes the exact
+// NativeTunnel JNI methods; ordinary `go test ./...` tests the core without a JDK.
+package main
+
+/*
+#include <stdlib.h>
+*/
+import "C"
+
+import (
+	"errors"
+	"sync"
+
+	wg "app.morphe/wireguard"
+)
+
+var current struct {
+	sync.Mutex
+	engine *wg.Engine
+}
+
+//export morphe_wg_start
+func morphe_wg_start(config, username, password *C.char, port C.int) (result C.int) {
+	result = -3
+	defer func() {
+		if recover() != nil {
+			result = -3
+		}
+	}()
+	current.Lock()
+	defer current.Unlock()
+	if current.engine != nil {
+		return -2
+	}
+	engine, err := wg.Start(C.GoString(config), C.GoString(username), C.GoString(password), int(port))
+	if err != nil {
+		var configErr *wg.ConfigError
+		if errors.As(err, &configErr) {
+			return -1
+		}
+		return -3
+	}
+	current.engine = engine
+	return C.int(engine.Port())
+}
+
+//export morphe_wg_stop
+func morphe_wg_stop() {
+	current.Lock()
+	defer current.Unlock()
+	if current.engine != nil {
+		current.engine.Close()
+		current.engine = nil
+	}
+}
+
+//export morphe_wg_validate
+func morphe_wg_validate(config *C.char) *C.char {
+	if err := wg.Validate(C.GoString(config)); err != nil {
+		// Validate only returns deliberately sanitized ConfigError messages.
+		return C.CString(err.Error())
+	}
+	return nil
+}
+
+func main() {}
diff --git a/native/wireguard/config.go b/native/wireguard/config.go
new file mode 100644
index 0000000000000000000000000000000000000000..35fa1012a8a199c166824d4203deb65617098c04
--- /dev/null
+++ b/native/wireguard/config.go
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+// Package wireguard provides an app-local, fail-closed WireGuard HTTP proxy.
+// It does not open an operating-system TUN device or change system routing.
+package wireguard
+
+import (
+	"bufio"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net/netip"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+const (
+	MaxConfigBytes = 64 * 1024
+	maxConfigLine  = 4096
+	maxAddresses   = 8
+	maxDNS         = 8
+	maxRoutes      = 256
+)
+
+// ConfigError intentionally contains no config values, key material, or file
+// contents. It is safe to display to the user, unlike arbitrary parser errors.
+type ConfigError struct{ Reason string }
+
+func (e *ConfigError) Error() string { return e.Reason }
+
+func invalid(reason string) error { return &ConfigError{Reason: reason} }
+
+type config struct {
+	privateKey [32]byte
+	publicKey  [32]byte
+	psk        [32]byte
+	hasPSK     bool
+	addresses  []netip.Addr
+	dns        []netip.Addr
+	routes     []netip.Prefix
+	endpoint   netip.AddrPort
+	listenPort uint16
+	keepalive  uint16
+	mtu        int
+}
+
+// Validate checks the supported, single-peer wg-quick .conf subset without
+// starting a listener, resolving names, contacting a peer, or running commands.
+func Validate(text string) error {
+	c, err := parseConfig(text)
+	if c != nil {
+		c.clearKeys()
+	}
+	return err
+}
+
+func parseConfig(text string) (_ *config, resultErr error) {
+	if len(text) == 0 || len(text) > MaxConfigBytes || !utf8.ValidString(text) || strings.ContainsRune(text, '\x00') {
+		return nil, invalid("Configuration must be valid UTF-8 text of at most 64 KiB.")
+	}
+	text = strings.TrimPrefix(text, "\ufeff")
+	c := &config{mtu: 1420}
+	defer func() {
+		if resultErr != nil {
+			c.clearKeys()
+		}
+	}()
+	section := ""
+	interfaceSeen, peerSeen := false, false
+	seen := make(map[string]bool)
+	scanner := bufio.NewScanner(strings.NewReader(text))
+	scanner.Buffer(make([]byte, 1024), maxConfigLine)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = strings.TrimSpace(line[:i])
+		}
+		if line == "" {
+			continue
+		}
+		if strings.HasPrefix(line, "[") {
+			switch strings.ToLower(line) {
+			case "[interface]":
+				if interfaceSeen || peerSeen {
+					return nil, invalid("Exactly one [Interface], followed by one [Peer], is supported.")
+				}
+				interfaceSeen, section = true, "interface"
+			case "[peer]":
+				if !interfaceSeen || peerSeen {
+					return nil, invalid("Exactly one [Peer] after [Interface] is supported.")
+				}
+				peerSeen, section = true, "peer"
+			default:
+				return nil, invalid("Configuration contains an unsupported section.")
+			}
+			continue
+		}
+		key, value, ok := strings.Cut(line, "=")
+		key, value = strings.ToLower(strings.TrimSpace(key)), strings.TrimSpace(value)
+		if !ok || section == "" || value == "" {
+			return nil, invalid("Configuration contains an invalid or empty directive.")
+		}
+		fullKey := section + "." + key
+		multi := fullKey == "interface.address" || fullKey == "interface.dns" || fullKey == "peer.allowedips"
+		if seen[fullKey] && !multi {
+			return nil, invalid("Duplicate singleton directives are not supported.")
+		}
+		seen[fullKey] = true
+		var err error
+		switch fullKey {
+		case "interface.privatekey":
+			c.privateKey, err = parseKey(value, false)
+		case "interface.address":
+			for _, item := range strings.Split(value, ",") {
+				p, parseErr := netip.ParsePrefix(strings.TrimSpace(item))
+				if parseErr != nil || !isUnicast(p.Addr()) || len(c.addresses) >= maxAddresses {
+					return nil, invalid("Address must contain at most 8 unicast IPv4/IPv6 CIDR addresses.")
+				}
+				addr := p.Addr().Unmap()
+				if containsAddr(c.addresses, addr) {
+					return nil, invalid("Duplicate interface addresses are not supported.")
+				}
+				c.addresses = append(c.addresses, addr)
+			}
+		case "interface.dns":
+			for _, item := range strings.Split(value, ",") {
+				addr, parseErr := netip.ParseAddr(strings.TrimSpace(item))
+				if parseErr != nil || !isUnicast(addr) || len(c.dns) >= maxDNS {
+					return nil, invalid("DNS must contain at most 8 numeric unicast IP addresses; search domains are unsupported.")
+				}
+				addr = addr.Unmap()
+				if !containsAddr(c.dns, addr) {
+					c.dns = append(c.dns, addr)
+				}
+			}
+		case "interface.listenport":
+			c.listenPort, err = parseUint16(value)
+		case "interface.mtu":
+			c.mtu, err = strconv.Atoi(value)
+			if err != nil || c.mtu < 576 || c.mtu > 9000 {
+				return nil, invalid("MTU must be between 576 and 9000 bytes.")
+			}
+		case "peer.publickey":
+			c.publicKey, err = parseKey(value, false)
+		case "peer.presharedkey":
+			c.psk, err = parseKey(value, true)
+			c.hasPSK = true
+		case "peer.endpoint":
+			c.endpoint, err = netip.ParseAddrPort(value)
+			if err != nil || !isUnicast(c.endpoint.Addr()) || c.endpoint.Port() == 0 {
+				return nil, invalid("Endpoint must be numeric IPv4:port or [IPv6]:port. Hostnames are unsupported in this version.")
+			}
+			c.endpoint = netip.AddrPortFrom(c.endpoint.Addr().Unmap(), c.endpoint.Port())
+		case "peer.allowedips":
+			for _, item := range strings.Split(value, ",") {
+				p, parseErr := netip.ParsePrefix(strings.TrimSpace(item))
+				if parseErr != nil || p.Addr().Zone() != "" || p.Addr().Is4In6() || len(c.routes) >= maxRoutes {
+					return nil, invalid("AllowedIPs must contain at most 256 valid IPv4/IPv6 CIDR routes.")
+				}
+				c.routes = append(c.routes, p.Masked())
+			}
+		case "peer.persistentkeepalive":
+			c.keepalive, err = parseUint16(value)
+		default:
+			// In particular: do not execute PreUp/PostUp/PreDown/PostDown;
+			// do not silently ignore Table, FwMark, SaveConfig or Amnezia keys.
+			return nil, invalid("Unsupported directive. Shell hooks, routing-table options, and non-WireGuard extensions are not accepted.")
+		}
+		if err != nil {
+			return nil, invalid("A key or numeric configuration value is invalid.")
+		}
+	}
+	if scanner.Err() != nil {
+		return nil, invalid("Configuration contains a line longer than 4 KiB.")
+	}
+	if !interfaceSeen || !peerSeen || !seen["interface.privatekey"] || !seen["peer.publickey"] || !seen["peer.endpoint"] || len(c.addresses) == 0 || len(c.routes) == 0 {
+		return nil, invalid("PrivateKey, Address, PublicKey, Endpoint and AllowedIPs are required.")
+	}
+	for _, addr := range c.addresses {
+		if addr.Is6() && c.mtu < 1280 {
+			return nil, invalid("IPv6 requires an MTU of at least 1280 bytes.")
+		}
+	}
+	if len(c.dns) == 0 {
+		return nil, invalid("At least one DNS server is required; system DNS fallback is disabled.")
+	}
+	for _, addr := range c.dns {
+		if !c.hasFamily(addr) || !c.allows(addr) {
+			return nil, invalid("Every DNS server must have a configured address family and be covered by AllowedIPs.")
+		}
+	}
+	return c, nil
+}
+
+func parseKey(value string, allowZero bool) ([32]byte, error) {
+	var key [32]byte
+	decoded, err := base64.StdEncoding.Strict().DecodeString(value)
+	defer clear(decoded)
+	if err != nil || len(decoded) != len(key) {
+		return key, errors.New("invalid key")
+	}
+	copy(key[:], decoded)
+	if !allowZero && key == ([32]byte{}) {
+		return key, errors.New("zero key")
+	}
+	return key, nil
+}
+
+func parseUint16(value string) (uint16, error) {
+	n, err := strconv.ParseUint(value, 10, 16)
+	return uint16(n), err
+}
+
+func isUnicast(addr netip.Addr) bool {
+	if !addr.IsValid() || addr.Zone() != "" {
+		return false
+	}
+	addr = addr.Unmap()
+	return (addr.IsGlobalUnicast() || addr.IsLoopback()) && !addr.IsLinkLocalUnicast()
+}
+
+func containsAddr(addrs []netip.Addr, target netip.Addr) bool {
+	for _, addr := range addrs {
+		if addr == target {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *config) hasFamily(addr netip.Addr) bool {
+	for _, local := range c.addresses {
+		if addr.Is4() == local.Is4() {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *config) allows(addr netip.Addr) bool {
+	addr = addr.Unmap()
+	for _, route := range c.routes {
+		if route.Contains(addr) {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *config) clearKeys() {
+	clear(c.privateKey[:])
+	clear(c.publicKey[:])
+	clear(c.psk[:])
+}
+
+// uapi is internal only: its result includes the private key. Never expose,
+// persist, or log it, and never expose Device.IpcGet() through the JNI API.
+func (c *config) uapi() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "private_key=%s\nlisten_port=%d\nreplace_peers=true\npublic_key=%s\nreplace_allowed_ips=true\nendpoint=%s\npersistent_keepalive_interval=%d\n",
+		hex.EncodeToString(c.privateKey[:]), c.listenPort, hex.EncodeToString(c.publicKey[:]), c.endpoint.String(), c.keepalive)
+	if c.hasPSK {
+		fmt.Fprintf(&b, "preshared_key=%s\n", hex.EncodeToString(c.psk[:]))
+	}
+	for _, prefix := range c.routes {
+		fmt.Fprintf(&b, "allowed_ip=%s\n", prefix.String())
+	}
+	return b.String()
+}
